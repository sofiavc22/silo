---
interface Props { home?: boolean }
const { home = false } = Astro.props;
const processHref = home ? '#proceso' : '/#proceso';
const coverageHref = home ? '#zonas' : '/#zonas';
const quoteHref = 'https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20una%20instalaci%C3%B3n';
---

<header class="site-header">
  <a class="site-logo" href="/" aria-label="SILO inicio"><img src="/images/silo-logo.png" alt="SILO" /></a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    <div class="site-dropdown">
      <button type="button" aria-haspopup="true">Soluciones <span>⌄</span></button>
      <div class="site-dropdown-menu">
        <a href="/servicios/instalacion-de-camaras-de-seguridad">Cámaras para interior</a>
        <a href="/servicios/instalacion-de-camaras-de-seguridad">Cámaras para exterior</a>
        <a href="/servicios/timbres-inteligentes">Timbres inteligentes</a>
        <a href="/servicios/instalacion-cerraduras-digitales">Cerraduras inteligentes</a>
        <a href="/servicios/sistemas-de-seguridad-para-casa">Sistemas de seguridad</a>
        <a href="/servicios/automatizacion-residencial">Automatización residencial</a>
      </div>
    </div>
    <a href={processHref}>Cómo funciona</a>
    <a href={coverageHref}>Cobertura</a>
    <a href="/promociones">Promociones</a>
    <a href="/blog">Blog</a>
  </nav>
  <a class="site-quote" href={quoteHref}>Cotizar ahora</a>
  <button class="site-menu" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
</header>
<nav class="site-mobile-nav" aria-label="Navegación móvil">
  <a href="/servicios/instalacion-de-camaras-de-seguridad">Cámaras de seguridad</a>
  <a href="/servicios/timbres-inteligentes">Timbres inteligentes</a>
  <a href="/servicios/instalacion-cerraduras-digitales">Cerraduras inteligentes</a>
  <a href="/servicios/sistemas-de-seguridad-para-casa">Sistemas de seguridad</a>
  <a href="/servicios/automatizacion-residencial">Automatización residencial</a>
  <a href={processHref}>Cómo funciona</a>
  <a href={coverageHref}>Cobertura</a>
  <a href="/promociones">Promociones</a>
  <a href="/blog">Blog</a>
</nav>

<script>
  const menuButton = document.querySelector('.site-menu');
  const mobileNav = document.querySelector('.site-mobile-nav');
  menuButton?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    menuButton.setAttribute('aria-expanded', String(open));
  });
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    mobileNav.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
  }));
</script>

<style>
  .site-header{position:sticky;top:0;z-index:50;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;border-bottom:1px solid #e8e8e8;background:rgba(255,255,255,.96);backdrop-filter:blur(12px)}
  .site-logo{display:inline-flex;align-items:center}.site-logo img{width:43px;height:52px;object-fit:contain}
  .desktop-nav{display:flex;gap:34px;font-size:12px;font-weight:700}.desktop-nav a:hover{color:#e61e32}
  .site-dropdown{position:relative}.site-dropdown>button{padding:0;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer}.site-dropdown>button span{color:#e61e32;margin-left:4px}.site-dropdown-menu{display:none;position:absolute;top:22px;left:-16px;z-index:60;width:230px;padding:10px 0;background:#fff;border:1px solid #ddd;box-shadow:0 10px 22px rgba(0,0,0,.08)}.site-dropdown-menu a{display:block;padding:10px 15px;font-size:11px}.site-dropdown-menu a:hover{background:#f7f7f7;color:#e61e32}.site-dropdown:hover .site-dropdown-menu,.site-dropdown:focus-within .site-dropdown-menu{display:block}
  .site-quote{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:48px!important;padding:12px 22px!important;border:1px solid rgba(255,255,255,.25)!important;border-radius:999px!important;background:linear-gradient(180deg,#f34a5c,#e61e32 48%,#bd1023)!important;box-shadow:0 8px 13px rgba(0,0,0,.16),inset 0 1px 1px rgba(255,255,255,.3)!important;color:#fff!important;font-size:12px!important;font-weight:700!important;line-height:1.2!important;white-space:nowrap!important;text-decoration:none!important}.site-quote:hover{background:#bd1023;color:#fff}
  :global(body :where(p,span,a,button,summary,li,small,label,strong,b,h3,h4,h5,h6)){font-weight:400!important}\n  .site-menu,.site-mobile-nav{display:none}
  @media(max-width:800px){.site-header{height:70px;padding:0 7vw;gap:10px}.desktop-nav{display:none}.site-quote{margin-left:auto;min-height:auto;padding:10px 13px;font-size:10px}.site-menu{display:block;margin-left:8px;padding:0;border:0;background:transparent;color:#090909;font-size:20px;cursor:pointer}.site-mobile-nav{position:fixed;z-index:45;top:70px;left:0;right:0;padding:12px 7vw 22px;background:#fff;border-bottom:1px solid #ddd;box-shadow:0 12px 22px rgba(0,0,0,.08)}.site-mobile-nav.open{display:grid}.site-mobile-nav a{padding:15px 0;border-bottom:1px solid #eee;font-size:13px;font-weight:600}.site-mobile-nav a:last-child{border-bottom:0}}
</style>
