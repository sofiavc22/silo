---
const phone = '6722671419';
---

<section class="coverage-block">
  <div>
    <p class="eyebrow">Cobertura</p>
    <h2>Instalamos en Ciudad de México y <em>Estado de México.</em></h2>
  </div>
  <div class="locations">
    <p>Estado de México</p>
    <small>Instalamos en los 125 municipios del Estado de México:</small>
    <div><a href="/zonas/huixquilucan">Huixquilucan</a><a href="/zonas/naucalpan">Naucalpan</a><a href="/zonas/metepec">Metepec</a><a href="/zonas/toluca">Toluca</a><a href="/zonas/tlalnepantla">Tlalnepantla</a></div>
    <p>Ciudad de México</p>
    <small>Instalamos en las 16 alcaldías de Ciudad de México:</small>
    <div><a href="/zonas/miguel-hidalgo">Miguel Hidalgo</a><a href="/zonas/benito-juarez">Benito Juárez</a><a href="/zonas/cuauhtemoc">Cuauhtémoc</a><a href="/zonas/alvaro-obregon">Álvaro Obregón</a><a href="/zonas/coyoacan">Coyoacán</a></div>
  </div>
</section>
<section class="next-step">
  <p class="eyebrow">Tu siguiente paso</p>
  <h2>Haz que tu casa esté segura y conectada 24/7.</h2>
  <p>Cuéntanos qué quieres instalar y te orientamos personalmente.</p>
  <a href={`https://wa.me/52${phone}?text=Hola%20SILO,%20quiero%20información%20sobre%20una%20instalación`}>Cotizar ahora</a>
</section>

<style>
  .coverage-block{padding:100px 7vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw;border-top:1px solid #ddd;background:#fff}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;color:#666;margin:0 0 25px}.coverage-block h2,.next-step h2{font-size:clamp(28px,3vw,48px);line-height:1.12;letter-spacing:-2px;margin:0;font-weight:600}.coverage-block h2 em{color:#e61e32;font-style:normal}.locations>p{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;border-top:1px solid #ccc;padding-top:18px;margin:0}.locations>p:not(:first-child){margin-top:34px}.locations small{display:block;margin:0 0 16px;font-size:12px;line-height:1.6;color:#777}.locations>div{display:flex;flex-wrap:wrap;gap:8px}.locations a{border:1px solid #ddd;padding:10px 12px;font-size:11px;font-weight:600;color:#090909;text-decoration:none}.locations a:hover{border-color:#e61e32;color:#e61e32}.next-step{padding:105px 7vw;text-align:center;border-top:1px solid #ddd;border-bottom:1px solid #ddd;background:#fff}.next-step .eyebrow{color:#e61e32}.next-step h2{max-width:760px;margin:0 auto 18px}.next-step>p:not(.eyebrow){font-size:15px;line-height:1.7;color:#666;margin:0 auto 28px}.next-step a{display:inline-flex;align-items:center;justify-content:center;padding:15px 23px;border-radius:999px;background:linear-gradient(180deg,#f34a5c,#e61e32 48%,#bd1023);box-shadow:0 8px 13px rgba(0,0,0,.16);color:#fff;font-size:12px;font-weight:700;text-decoration:none}@media(max-width:800px){.coverage-block{display:block;padding:75px 7vw}.locations{margin-top:40px}.next-step{padding:80px 7vw}}
</style>
