---
const {
  message = 'También tenemos paquetes con instalación incluida.',
} = Astro.props;
---

<aside class="promotion-popup" data-promotion-popup aria-label="Promociones disponibles">
  <button class="promotion-popup-close" type="button" aria-label="Cerrar aviso" data-promotion-popup-close>×</button>
  <div class="promotion-popup-mark" aria-hidden="true">%</div>
  <div class="promotion-popup-copy">
    <p class="promotion-popup-title">¿Buscas una promoción?</p>
    <p>{message}</p>
    <a href="/promociones">Ver promociones disponibles</a>
  </div>
</aside>

<script>
  const popup = document.querySelector('[data-promotion-popup]');
  const closeButton = popup?.querySelector('[data-promotion-popup-close]');
  const storageKey = 'silo-promotion-popup-closed';

  if (popup && sessionStorage.getItem(storageKey) === 'true') {
    popup.remove();
  }

  closeButton?.addEventListener('click', () => {
    sessionStorage.setItem(storageKey, 'true');
    popup?.remove();
  });
</script>

<style>
  .promotion-popup{position:fixed;z-index:30;right:28px;bottom:28px;display:flex;align-items:flex-start;gap:15px;width:min(470px,calc(100vw - 36px));padding:21px 46px 20px 20px;border:1px solid #e4e4e4;border-radius:24px;background:#fff;box-shadow:0 16px 42px rgba(0,0,0,.16);color:#111}
  .promotion-popup-mark{display:flex;flex:0 0 auto;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:#e61e32;color:#fff;font-size:25px;font-weight:700;line-height:1}
  .promotion-popup-copy{min-width:0}
  .promotion-popup-copy p{margin:0;color:#5f5f5f;font-size:15px;line-height:1.42}
  .promotion-popup-copy .promotion-popup-title{margin-bottom:3px;color:#111;font-size:18px;font-weight:700;letter-spacing:-.035em}
  .promotion-popup-copy a{display:inline-block;margin-top:12px;color:#111;font-size:14px;font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
  .promotion-popup-close{position:absolute;top:14px;right:15px;width:29px;height:29px;padding:0;border:0;border-radius:50%;background:transparent;color:#777;cursor:pointer;font-size:25px;font-weight:300;line-height:1}
  .promotion-popup-close:hover{background:#f4f4f4;color:#111}
  @media(max-width:640px){.promotion-popup{right:18px;bottom:18px;padding:17px 39px 17px 17px;border-radius:19px;gap:12px}.promotion-popup-mark{width:42px;height:42px;font-size:22px}.promotion-popup-copy p{font-size:14px}.promotion-popup-copy .promotion-popup-title{font-size:17px}.promotion-popup-copy a{margin-top:9px;font-size:13px}}
</style>
