  .hero{background:#fff;color:#090909;border-bottom:1px solid #ddd}.hero .eyebrow{color:#e61e32}.hero p:not(.eyebrow){color:#666}.button{background:#e61e32;color:#fff}.local{background:#fff;color:#090909;border-top:1px solid #ddd;border-bottom:1px solid #ddd}.local .eyebrow{color:#e61e32}.local p:not(.eyebrow){color:#666}.local a{color:#e61e32}footer{background:#fff;color:#090909;border-top:1px solid #ddd}
