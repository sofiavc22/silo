---
export function getStaticPaths() { return [
  ['huixquilucan', 'Huixquilucan', 'Estado de México'], ['naucalpan', 'Naucalpan de Juárez', 'Estado de México'], ['metepec', 'Metepec', 'Estado de México'], ['toluca', 'Toluca', 'Estado de México'], ['tlalnepantla', 'Tlalnepantla', 'Estado de México'], ['miguel-hidalgo', 'Miguel Hidalgo', 'Ciudad de México'], ['benito-juarez', 'Benito Juárez', 'Ciudad de México'], ['cuauhtemoc', 'Cuauhtémoc', 'Ciudad de México'], ['alvaro-obregon', 'Álvaro Obregón', 'Ciudad de México'], ['coyoacan', 'Coyoacán', 'Ciudad de México'],
].map(([slug, name, state]) => ({ params: { slug }, props: { name, state } })); }
const { name, state } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Seguridad inteligente en {name} | SILO</title><meta name="description" content={`Instalación de cámaras Ring y Nest, timbres, cerraduras Yale y automatización residencial en ${name}, ${state}.`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/></head><body><header><a class="logo" href="/">SILO<span>.</span></a><a class="call" href="tel:6722671419">672 267 1419</a></header><main><section class="hero"><p class="eyebrow">SILO / {state.toUpperCase()}</p><h1>Seguridad inteligente en <em>{name}.</em></h1><p>Instalamos cámaras Ring y Nest, timbres inteligentes, cerraduras Yale y soluciones de automatización para hogares en {name}.</p><a class="button" href="https://wa.me/526722671419?text=Hola%20SILO,%20vivo%20en%20${encodeURIComponent(name)}%20y%20quiero%20cotizar">Solicitar cotización <b>↗</b></a></section><section class="content"><div><p class="eyebrow">Una solución para tu casa</p><h2>Más control.<br/><span>Más tranquilidad.</span></h2><p>En SILO te ayudamos a elegir, instalar y configurar tecnología para que puedas proteger tu hogar y controlarlo desde tu celular. Trabajamos con marcas premium y dejamos cada sistema listo para usar.</p></div><div class="services"><div><b>01</b><strong>Cámaras Ring y Nest</strong><span>Visualiza y recibe alertas desde tu celular.</span></div><div><b>02</b><strong>Timbres inteligentes</strong><span>Responde a tus visitas aunque no estés en casa.</span></div><div><b>03</b><strong>Cerraduras Yale</strong><span>Accede a tu hogar de forma más práctica.</span></div><div><b>04</b><strong>Automatización residencial</strong><span>Controla tu casa con Alexa y tus dispositivos.</span></div></div></section><section class="local"><p class="eyebrow">Instalación profesional en {name}</p><h2>La tecnología funciona mejor cuando está bien instalada.</h2><p>Cuéntanos qué quieres proteger o automatizar. Te orientamos sobre el equipo correcto para tu propiedad y coordinamos tu instalación.</p><a href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20agendar%20una%20instalaci%C3%B3n%20en%20${encodeURIComponent(name)}">Hablar con SILO →</a></section></main><footer><a class="logo" href="/">SILO<span>.</span></a><span>CDMX · Estado de México</span></footer></body></html>
