---
export function getStaticPaths() {
  return [
    ["huixquilucan", "Huixquilucan", "Estado de México"],
    ["naucalpan", "Naucalpan de Juárez", "Estado de México"],
    ["metepec", "Metepec", "Estado de México"],
    ["toluca", "Toluca", "Estado de México"],
    ["tlalnepantla", "Tlalnepantla", "Estado de México"],
    ["miguel-hidalgo", "Miguel Hidalgo", "Ciudad de México"],
    ["benito-juarez", "Benito Juárez", "Ciudad de México"],
    ["cuauhtemoc", "Cuauhtémoc", "Ciudad de México"],
    ["alvaro-obregon", "Álvaro Obregón", "Ciudad de México"],
    ["coyoacan", "Coyoacán", "Ciudad de México"],
  ].map(([slug, name, state]) => ({
    params: { slug },
    props: { name, state },
  }));
}
const { name, state } = Astro.props;
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${name}, ${state}, México`)}&output=embed`;
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const description = `Instalación de cámaras de seguridad, timbres, cerraduras inteligentes y automatización residencial en ${name}, ${state}.`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Seguridad inteligente en {name} | SILO</title>
    <meta name="description" content={description} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={`Seguridad inteligente en ${name} | SILO`}
    />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: `Instalación de seguridad inteligente en ${name}`,
        description,
        provider: {
          "@type": "HomeAndConstructionBusiness",
          name: "SILO",
          telephone: "+52 672 267 1419",
        },
        areaServed: {
          "@type": "AdministrativeArea",
          name: `${name}, ${state}`,
        },
      })}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
          {
            "@type": "ListItem",
            position: 2,
            name: "Cobertura",
            item: siteUrl ? `${siteUrl}/#zonas` : undefined,
          },
          { "@type": "ListItem", position: 3, name, item: pageUrl },
        ],
      })}
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <a class="logo" href="/" aria-label="SILO inicio">
        <img src="/images/silo-logo.png" alt="SILO" />
      </a>
      <nav aria-label="Navegación principal">
        <div class="nav-dropdown">
          <button type="button" aria-haspopup="true">
            Soluciones <span>⌄</span>
          </button>
          <div class="dropdown-menu">
            <a href="/servicios/camaras-ring-nest">Cámaras para interior</a>
            <a href="/servicios/camaras-ring-nest">Cámaras para exterior</a>
            <a href="/servicios/timbres-inteligentes">Timbres inteligentes</a>
            <a href="/servicios/cerraduras-yale">Cerraduras inteligentes</a>
            <a href="/servicios/automatizacion-residencial">
              Automatización residencial
            </a>
          </div>
        </div>
        <a href="/#proceso">Cómo funciona</a>
        <a href="/#zonas">Cobertura</a>
      </nav>
      <a
        class="header-call"
        href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20una%20instalación"
      >
        Cotizar ahora
      </a>
      <button
        class="menu"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        ☰
      </button>
    </header>
    <nav class="mobile-nav" aria-label="Navegación móvil">
      <a href="/servicios/camaras-ring-nest">Cámaras de seguridad</a>
      <a href="/servicios/timbres-inteligentes">Timbres inteligentes</a>
      <a href="/servicios/cerraduras-yale">Cerraduras inteligentes</a>
      <a href="/servicios/automatizacion-residencial">
        Automatización residencial
      </a>
      <a href="/#proceso">Cómo funciona</a>
      <a href="/#zonas">Cobertura</a>
    </nav>
    <a
      class="mobile-quote"
      href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20una%20instalación"
    >
      Cotizar ahora
    </a>
    <main>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#zonas">Cobertura</a>
        <span>/</span>
        <span aria-current="page">{name}</span>
      </nav>
      <section class="hero">
        <p class="eyebrow">SILO / {state.toUpperCase()}</p>
        <h1>
          Seguridad inteligente en <em>{name}.</em>
        </h1>
        <p>
          Instalamos cámaras de seguridad, timbres, cerraduras inteligentes y
          automatización residencial en hogares de {name}.
        </p>
        <a
          class="button"
          href={`https://wa.me/526722671419?text=Hola%20SILO,%20vivo%20en%20${encodeURIComponent(name)}%20y%20quiero%20cotizar`}
        >
          Solicitar cotización
        </a>
      </section>
      <section class="content">
        <div>
          <p class="eyebrow">Una solución para tu casa</p>
          <h2>Instalación de cámaras de seguridad y automatizaciones en {name}</h2>
          <p>
            En SILO te ayudamos a elegir, instalar y configurar tecnología para
            proteger tu hogar y controlarlo desde el celular. Revisamos tus
            accesos, espacios clave y rutina para recomendarte una solución
            clara y funcional.
          </p>
        </div>
        <div class="services">
          <div>
            <b>01</b>
            <strong>Cámaras de seguridad</strong>
            <span>
              Para interior y exterior, con visualización desde tu celular.
            </span>
          </div>
          <div>
            <b>02</b>
            <strong>Timbres inteligentes</strong>
            <span>Ve y responde a tus visitas aunque no estés en casa.</span>
          </div>
          <div>
            <b>03</b>
            <strong>Cerraduras inteligentes</strong>
            <span>Controla quién entra a tu hogar de forma más práctica.</span>
          </div>
          <div>
            <b>04</b>
            <strong>Automatización residencial</strong>
            <span>Conecta funciones de tu casa y crea rutinas sencillas.</span>
          </div>
        </div>
      </section>
      <section class="process">
        <div>
          <p class="eyebrow">Instalación en {name}</p>
          <h2>Cómo instalamos cámaras de seguridad, timbres y cerraduras inteligentes en {name}</h2>
          <p>
            Desde la primera recomendación hasta la configuración final, te
            acompañamos para que cada dispositivo quede listo para usar.
          </p>
        </div>
        <div class="process-steps">
          <article>
            <span>01</span>
            <h3>Revisamos tu espacio</h3>
            <p>
              Entendemos qué necesitas proteger y los puntos que quieres
              controlar.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>Te recomendamos</h3>
            <p>Elegimos los equipos y la ubicación adecuada para tu hogar.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Instalamos y configuramos</h3>
            <p>
              Dejamos la app, las alertas y tus dispositivos listos para usar.
            </p>
          </article>
        </div>
      </section>
      <section class="coverage">
        <div class="map-copy">
          <p class="eyebrow">Cobertura local</p>
          <h2>
            Instalamos en {name}
            <br />y alrededores.
          </h2>
          <p>
            Coordinamos instalaciones residenciales en {name}, {state}, y zonas
            cercanas. Escríbenos para confirmar disponibilidad en tu domicilio.
          </p>
          <a
            href={`https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20confirmar%20cobertura%20en%20${encodeURIComponent(name)}`}
          >
            Confirmar cobertura
          </a>
        </div>
        <div class="map">
          <iframe
            title={`Mapa de cobertura de SILO en ${name}`}
            src={mapUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
      <section class="local">
        <p class="eyebrow">Habla con SILO</p>
        <h2>Cotiza instalación de seguridad inteligente en {name}</h2>
        <p>
          Cuéntanos qué quieres instalar en {name} y te orientamos
          personalmente.
        </p>
        <a
          class="button"
          href={`https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20agendar%20una%20instalación%20en%20${encodeURIComponent(name)}`}
        >
          Hablar por WhatsApp
        </a>
      </section>
    </main>
    <footer>
      <a class="logo" href="/">
        <img src="/images/silo-logo.png" alt="SILO" />
      </a>
      <span>CDMX · Estado de México</span>
    </footer>
    <script>
      const menuButton = document.querySelector(".menu");
      const mobileNav = document.querySelector(".mobile-nav");
      menuButton?.addEventListener("click", () => {
        const open = mobileNav?.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(open));
      });
      mobileNav?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => {
          mobileNav.classList.remove("open");
          menuButton?.setAttribute("aria-expanded", "false");
        }),
      );
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    color: #090909;
    background: #fff;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 82px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5vw;
  }
  .logo {
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -2px;
  }
  .logo span {
    color: #e61e32;
  }
  .lock {
    font-size: 16px;
    letter-spacing: 0;
    margin-left: 5px;
    filter: grayscale(1);
  }
  .topbar nav {
    display: flex;
    gap: 34px;
    font-size: 12px;
    font-weight: 700;
  }
  .topbar nav a:hover,
  .nav-dropdown > button:hover {
    color: #e61e32;
  }
  .header-call {
    font-size: 12px;
    font-weight: 800;
  }
  .menu {
    display: none;
  }
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown > button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .nav-dropdown > button span {
    color: #e61e32;
    margin-left: 4px;
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 22px;
    left: -16px;
    z-index: 30;
    width: 230px;
    padding: 10px 0;
    background: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.08);
  }
  .dropdown-menu a {
    display: block;
    padding: 10px 15px;
    font-size: 11px;
  }
  .dropdown-menu a:hover {
    background: #f7f7f7;
    color: #e61e32;
  }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: block;
  }
  .breadcrumbs {
    max-width: 76vw;
    margin: 22px auto -30px;
    font-size: 11px;
    color: #666;
  }
  .breadcrumbs a:hover {
    color: #e61e32;
  }
  .breadcrumbs span {
    margin: 0 7px;
  }
  .hero {
    padding: 125px 12vw 135px;
    border-bottom: 1px solid #ddd;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 800;
    margin: 0 0 26px;
    color: #777;
  }
  .hero .eyebrow,
  .local .eyebrow {
    color: #e61e32;
  }
  .hero h1 {
    font-size: clamp(38px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -3px;
    max-width: 900px;
    margin: 0 0 28px;
    font-weight: 600;
  }
  .hero h1 em,
  .content h2 span {
    color: #e61e32;
    font-style: normal;
  }
  .hero p:not(.eyebrow) {
    font-size: 18px;
    line-height: 1.6;
    color: #666;
    max-width: 650px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 172px;
    margin-top: 22px;
    padding: 15px 23px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: linear-gradient(180deg, #f34a5c, #e61e32 48%, #bd1023);
    box-shadow:
      0 8px 13px rgba(0, 0, 0, 0.16),
      inset 0 1px 1px rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }
  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10vw;
    padding: 120px 12vw;
  }
  .content h2,
  .process h2,
  .coverage h2,
  .local h2 {
    font-size: clamp(28px, 3vw, 48px);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 0 0 25px;
    font-weight: 600;
  }
  .content > div > p:last-child,
  .process > div > p:last-child,
  .map-copy > p:last-of-type,
  .local > p:not(.eyebrow) {
    font-size: 15px;
    line-height: 1.8;
    color: #666;
    max-width: 530px;
  }
  .services {
    border-top: 1px solid #ccc;
  }
  .services div {
    display: grid;
    grid-template-columns: 35px 1fr;
    gap: 7px;
    padding: 19px 0;
    border-bottom: 1px solid #ccc;
  }
  .services b {
    grid-row: span 2;
    color: #e61e32;
    font-size: 11px;
  }
  .services strong {
    font-size: 14px;
  }
  .services span {
    font-size: 11px;
    color: #777;
  }
  .process {
    padding: 110px 12vw;
    border-top: 1px solid #ddd;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9vw;
  }
  .process-steps article {
    border-top: 1px solid #ccc;
    padding: 19px 0;
  }
  .process-steps span {
    color: #e61e32;
    font-size: 11px;
    font-weight: 800;
  }
  .process-steps h3 {
    font-size: 16px;
    margin: 18px 0 8px;
    font-weight: 600;
  }
  .process-steps p {
    font-size: 12px;
    line-height: 1.65;
    color: #666;
    margin: 0;
  }
  .coverage {
    padding: 0 7vw 110px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    align-items: center;
  }
  .map-copy {
    padding-left: 5vw;
  }
  .map-copy a {
    display: inline-block;
    margin-top: 17px;
    font-size: 12px;
    font-weight: 800;
    color: #e61e32;
  }
  .map {
    height: 430px;
    border: 1px solid #ddd;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1);
  }
  .local {
    padding: 105px 12vw;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
  }
  .local h2 {
    max-width: 730px;
  }
  .local .button {
    margin-top: 10px;
  }
  footer {
    background: #fff;
    color: #090909;
    border-top: 1px solid #ddd;
    display: flex;
    justify-content: space-between;
    padding: 35px 5vw;
    font-size: 11px;
  }
  footer span {
    color: #777;
  }
  @media (max-width: 800px) {
    .topbar {
      height: 70px;
    }
    .topbar nav,
    .header-call {
      display: none;
    }
    .menu {
      display: block;
      font-size: 22px;
    }
    .breadcrumbs {
      margin: 16px 7vw -25px;
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hero {
      padding: 85px 7vw;
    }
    .content,
    .process,
    .coverage {
      display: block;
      padding: 80px 7vw;
    }
    .services,
    .process-steps {
      margin-top: 55px;
    }
    .coverage {
      padding-top: 0;
    }
    .map-copy {
      padding: 0;
      margin-bottom: 45px;
    }
    .map {
      height: 320px;
    }
    .local {
      padding: 80px 7vw;
    }
    footer {
      display: block;
    }
    footer span {
      display: block;
      margin-top: 20px;
    }
  }
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    width: 43px;
    height: 52px;
    object-fit: contain;
  }
  .mobile-nav,
  .mobile-quote {
    display: none;
  }
  @media (max-width: 800px) {
    :global(body) {
      padding-bottom: 76px;
    }
    .menu {
      border: 0;
      background: transparent;
      padding: 0;
      color: #090909;
      cursor: pointer;
    }
    .mobile-nav {
      position: fixed;
      z-index: 45;
      top: 70px;
      left: 0;
      right: 0;
      padding: 12px 7vw 22px;
      background: #fff;
      border-bottom: 1px solid #ddd;
      box-shadow: 0 12px 22px rgba(0, 0, 0, 0.08);
    }
    .mobile-nav.open {
      display: grid;
    }
    .mobile-nav a {
      padding: 15px 0;
      border-bottom: 1px solid #eee;
      font-size: 13px;
      font-weight: 600;
    }
    .mobile-nav a:last-child {
      border-bottom: 0;
    }
    .mobile-quote {
      display: flex;
      position: fixed;
      z-index: 60;
      bottom: 14px;
      left: 7vw;
      right: 7vw;
      align-items: center;
      justify-content: center;
      padding: 16px 20px;
      border-radius: 999px;
      background: linear-gradient(180deg, #f34a5c, #e61e32 48%, #bd1023);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
    }
  }
</style>
<style>
  @media(max-width:800px){:global(body){padding-bottom:0}.mobile-quote{display:none!important}.topbar .header-call{display:inline-flex!important;align-items:center;justify-content:center;padding:10px 13px;border-radius:999px;background:#e61e32;color:#fff;font-size:10px;white-space:nowrap}.topbar{gap:10px}.menu{font-size:20px}}
</style>
