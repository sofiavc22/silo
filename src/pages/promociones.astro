---
import SiteHeader from '../components/SiteHeader.astro';
import CoverageAndCta from '../components/CoverageAndCta.astro';

const promotion = {
  brand: 'TP-Link',
  name: 'Paquete de 3 cámaras 3K para exterior',
  price: '$7,999 MXN',
  image: '/images/promotions/tplink-3-camaras-3k-exterior.webp',
  features: [
    'Resolución 3K (5 MP)',
    'Visión nocturna a color',
    'Detección de movimiento',
    'Audio bidireccional',
    'Almacenamiento en nube o microSD',
    'Resistentes a la intemperie',
  ],
  includes: [
    '3 cámaras TP-Link para exterior',
    'Instalación y material necesario',
    'Configuración en dispositivos móviles',
    'Almacenamiento',
    '1 año de garantía por escrito',
  ],
};

const accessPromotion = {
  brand: 'TP-Link + Yale',
  name: 'Cámara exterior 2K + cerradura inteligente',
  price: '$6,999 MXN',
  image: '/images/promotions/tapo-yale-2k-cerradura.webp',
  features: [
    'Cámara exterior TP-Link con resolución 2K',
    'Visión nocturna a color',
    'Audio bidireccional',
    'Cerradura digital Yale con teclado táctil',
    'Acceso y control desde la aplicación',
  ],
  includes: [
    '1 cámara exterior 2K y 1 cerradura inteligente',
    'Instalación y material necesario',
    'Configuración en dispositivos móviles',
    'Almacenamiento para la cámara',
    '1 año de garantía por escrito',
  ],
};

const dualCameraPromotion = {
  brand: 'TP-Link',
  name: 'Paquete de 2 cámaras 1080p para exterior',
  price: '$5,499 MXN',
  image: '/images/promotions/tplink-2-camaras-1080p-exterior.webp',
  features: [
    'Resolución 1080p',
    'Visión nocturna a color',
    'Detección de movimiento',
    'Audio bidireccional',
    'Almacenamiento en nube o microSD',
    'Resistentes a la intemperie',
  ],
  includes: [
    '2 cámaras TP-Link para exterior',
    'Instalación y material necesario',
    'Configuración en dispositivos móviles',
    'Almacenamiento',
    '1 año de garantía por escrito',
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promociones de cámaras de seguridad | SILO</title>
    <meta name="description" content="Promociones de cámaras de seguridad con instalación incluida en CDMX y Estado de México." />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="marketplace" aria-labelledby="promociones-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Promociones SILO</p>
            <h1 id="promociones-title">Promociones con instalación incluida</h1>
            <p class="intro">Elige un paquete y recibe equipo, instalación, configuración, almacenamiento y garantía en un solo precio.</p>
          </div>
          <span class="count">3 promociones disponibles</span>
        </div>

        <div class="product-grid">
          <article class="promotion-card">
            <div class="product-image">
              <img src={promotion.image} alt="Tres cámaras TP-Link Tapo 3K para exterior" />
            </div>
            <div class="product-copy">
              <p class="badge">Promoción</p>
              <p class="brand">{promotion.brand}</p>
              <h2>{promotion.name}</h2>
              <p class="price">{promotion.price}</p>
              <p class="included-line">Instalación de 3 cámaras todo incluido</p>

              <div class="product-details">
                <div>
                  <h3>Características</h3>
                  <ul>{promotion.features.map((feature) => <li>{feature}</li>)}</ul>
                </div>
                <div>
                  <h3>Incluye</h3>
                  <ul>{promotion.includes.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>

              <a class="quote-button" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20solicitar%20la%20promoci%C3%B3n%20de%203%20c%C3%A1maras%20TP-Link%203K">Solicitar promoción</a>
            </div>
          </article>

          <article class="promotion-card">
            <div class="product-image">
              <img src={accessPromotion.image} alt="Cámara exterior TP-Link 2K y cerradura inteligente Yale" />
            </div>
            <div class="product-copy">
              <p class="badge">Promoción</p>
              <p class="brand">{accessPromotion.brand}</p>
              <h2>{accessPromotion.name}</h2>
              <p class="price">{accessPromotion.price}</p>
              <p class="included-line">Instalación de cámara y cerradura incluida</p>

              <div class="product-details">
                <div>
                  <h3>Características</h3>
                  <ul>{accessPromotion.features.map((feature) => <li>{feature}</li>)}</ul>
                </div>
                <div>
                  <h3>Incluye</h3>
                  <ul>{accessPromotion.includes.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>

              <a class="quote-button" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20solicitar%20la%20promoci%C3%B3n%20de%20c%C3%A1mara%20exterior%202K%20y%20cerradura%20inteligente">Solicitar promoción</a>
            </div>
          </article>

          <article class="promotion-card">
            <div class="product-image">
              <img src={dualCameraPromotion.image} alt="Dos cámaras TP-Link 1080p para exterior" />
            </div>
            <div class="product-copy">
              <p class="badge">Promoción</p>
              <p class="brand">{dualCameraPromotion.brand}</p>
              <h2>{dualCameraPromotion.name}</h2>
              <p class="price">{dualCameraPromotion.price}</p>
              <p class="included-line">Instalación de 2 cámaras todo incluido</p>

              <div class="product-details">
                <div>
                  <h3>Características</h3>
                  <ul>{dualCameraPromotion.features.map((feature) => <li>{feature}</li>)}</ul>
                </div>
                <div>
                  <h3>Incluye</h3>
                  <ul>{dualCameraPromotion.includes.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>

              <a class="quote-button" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20solicitar%20la%20promoci%C3%B3n%20de%202%20c%C3%A1maras%20TP-Link%201080p">Solicitar promoción</a>
            </div>
          </article>
        </div>
      </section>

      <CoverageAndCta />
    </main>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;color:#090909;font-family:Inter,Arial,sans-serif;background:#fff}
  :global(a){color:inherit;text-decoration:none}
  .marketplace{width:min(1450px,94vw);margin:0 auto;padding:62px 0 92px}
  .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:36px;padding-bottom:27px;border-bottom:1px solid #d9d9d9}
  .eyebrow,.brand{margin:0;color:#e61e32;font-size:12px;font-weight:750;letter-spacing:.13em;text-transform:uppercase}
  h1,h2,h3{margin:0}
  h1{max-width:760px;margin-top:15px;font-size:clamp(34px,4vw,58px);font-weight:600;line-height:1.04;letter-spacing:-.055em}
  .intro{max-width:660px;margin:18px 0 0;color:#5e5e5e;font-size:16px;line-height:1.55}
  .count{color:#666;font-size:14px;white-space:nowrap}
  .product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .promotion-card{display:flex;min-height:625px;flex-direction:column;overflow:hidden;border:1px solid #e0e0e0;border-radius:18px;background:#fff}
  .product-image{display:flex;height:240px;align-items:center;justify-content:center;padding:12px;background:#f5f5f5}
  .product-image img{display:block;width:100%;height:100%;object-fit:contain}
  .product-copy{display:flex;flex:1;flex-direction:column;padding:18px}
  .badge{align-self:flex-start;margin:0 0 14px;padding:6px 9px;border-radius:5px;background:#e61e32;color:#fff;font-size:11px;font-weight:700}
  .brand{margin-bottom:8px;font-size:10px}
  .product-copy h2{font-size:19px;font-weight:600;line-height:1.17;letter-spacing:-.035em}
  .price{margin:17px 0 4px;font-size:29px;font-weight:400;letter-spacing:-.05em}
  .included-line{margin:0;color:#606060;font-size:13px;line-height:1.35}
  .product-details{display:grid;gap:17px;margin:19px 0 22px;padding:18px 0;border-top:1px solid #dfdfdf;border-bottom:1px solid #dfdfdf}
  .product-details h3{margin-bottom:8px;font-size:12px;font-weight:650}
  ul{display:grid;gap:6px;margin:0;padding:0;list-style:none;color:#5b5b5b;font-size:12px;line-height:1.32}
  li{position:relative;padding-left:13px}
  li::before{position:absolute;left:0;color:#e61e32;content:'•'}
  .quote-button{display:flex;align-items:center;justify-content:center;margin-top:auto;padding:13px 15px;border-radius:999px;background:linear-gradient(180deg,#f34a5c 0%,#e61e32 48%,#bd1023 100%);box-shadow:0 7px 12px rgba(0,0,0,.15),inset 0 1px 1px rgba(255,255,255,.28);color:#fff;font-size:13px;font-weight:700;transition:transform .2s ease}
  .quote-button:hover{color:#fff;transform:translateY(-1px)}
  @media(max-width:1050px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:760px){.marketplace{width:min(100% - 36px,560px);padding:46px 0 64px}.section-heading{align-items:flex-start;flex-direction:column;gap:14px;margin-bottom:24px}.intro{font-size:15px}.product-grid{grid-template-columns:1fr}.promotion-card{min-height:auto}.product-image{height:270px}.product-copy{padding:22px}.product-copy h2{font-size:22px}.price{font-size:31px}.product-details{grid-template-columns:1fr}}
</style>
