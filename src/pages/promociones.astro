---
import SiteHeader from '../components/SiteHeader.astro';
import CoverageAndCta from '../components/CoverageAndCta.astro';

const promotion = {
  brand: 'TP-Link',
  name: 'Paquete de 3 cámaras 3K para exterior',
  price: '$7,999 MXN',
  image: '/images/promotions/tplink-3-camaras-3k-exterior.webp',
  features: [
    'Resolución 3K (5 MP)',
    'Visión nocturna a color',
    'Detección de movimiento',
    'Audio bidireccional',
    'Almacenamiento en nube o microSD',
    'Resistentes a la intemperie',
  ],
  includes: [
    '3 cámaras TP-Link para exterior',
    'Instalación y material necesario',
    'Configuración en dispositivos móviles',
    'Almacenamiento',
    '1 año de garantía por escrito',
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promociones de cámaras de seguridad | SILO</title>
    <meta name="description" content="Conoce nuestras promociones de cámaras de seguridad con instalación incluida en CDMX y Estado de México." />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <p class="eyebrow">Promociones SILO</p>
        <h1>Equipos con instalación incluida</h1>
        <p>Arma tu sistema de seguridad con equipos, instalación, configuración y garantía en un solo precio.</p>
      </section>

      <section class="marketplace" aria-labelledby="promociones-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Ofertas disponibles</p>
            <h2 id="promociones-title">Promociones en cámaras de seguridad</h2>
          </div>
          <span>1 promoción disponible</span>
        </div>

        <article class="promotion-card">
          <div class="product-image">
            <img src={promotion.image} alt="Tres cámaras TP-Link Tapo 3K para exterior" />
          </div>
          <div class="product-info">
            <p class="brand">{promotion.brand}</p>
            <h2>{promotion.name}</h2>
            <p class="price">{promotion.price}</p>
            <p class="included-line">Instalación de 3 cámaras todo incluido</p>

            <div class="details">
              <div>
                <h3>Características</h3>
                <ul>
                  {promotion.features.map((feature) => <li>{feature}</li>)}
                </ul>
              </div>
              <div>
                <h3>Este paquete incluye</h3>
                <ul>
                  {promotion.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>

            <a class="quote-button" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20solicitar%20la%20promoci%C3%B3n%20de%203%20c%C3%A1maras%20TP-Link%203K">Solicitar promoción</a>
          </div>
        </article>
      </section>

      <CoverageAndCta />
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #0a0a0a; font-family: Inter, Arial, sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  .hero { padding: 86px 7vw 68px; background: #f5f5f3; border-bottom: 1px solid #dededb; }
  .hero h1, .section-heading h2, .product-info h2, .product-info h3 { margin: 0; }
  .hero h1 { max-width: 680px; font-size: clamp(38px, 5vw, 70px); line-height: .98; letter-spacing: -.065em; }
  .hero > p:last-child { max-width: 590px; margin: 23px 0 0; color: #5d5d5d; font-size: 19px; line-height: 1.45; }
  .eyebrow, .brand { margin: 0 0 16px; color: #e61e32; font-size: 12px; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  .marketplace { width: min(1240px, 86vw); margin: 0 auto; padding: 76px 0 96px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 30px; padding-bottom: 24px; border-bottom: 1px solid #d9d9d9; }
  .section-heading h2 { font-size: clamp(28px, 3vw, 42px); line-height: 1.05; letter-spacing: -.045em; }
  .section-heading span { color: #666; font-size: 14px; white-space: nowrap; }
  .promotion-card { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); overflow: hidden; border: 1px solid #dfdfdf; border-radius: 24px; background: #fff; }
  .product-image { min-height: 530px; padding: 24px; background: #f6f6f5; display: flex; align-items: center; justify-content: center; }
  .product-image img { display: block; width: 100%; max-width: 720px; height: auto; }
  .product-info { display: flex; min-height: 530px; flex-direction: column; padding: 46px 46px 40px; }
  .product-info h2 { max-width: 570px; font-size: clamp(30px, 3vw, 45px); line-height: 1.04; letter-spacing: -.055em; }
  .price { margin: 28px 0 6px; font-size: 38px; font-weight: 400; letter-spacing: -.045em; }
  .included-line { margin: 0; color: #5e5e5e; font-size: 15px; }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin: 33px 0; padding: 26px 0; border-top: 1px solid #ddd; border-bottom: 1px solid #ddd; }
  .product-info h3 { margin-bottom: 13px; font-size: 14px; font-weight: 650; }
  ul { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; color: #555; font-size: 14px; line-height: 1.34; }
  li { position: relative; padding-left: 17px; }
  li::before { position: absolute; left: 0; color: #e61e32; content: '•'; }
  .quote-button { align-self: flex-start; margin-top: auto; padding: 15px 22px; border-radius: 999px; background: #e61e32; color: #fff; font-size: 14px; font-weight: 700; box-shadow: 0 9px 16px rgba(230,30,50,.18); }
  .quote-button:hover { background: #c91529; }
  @media (max-width: 850px) {
    .hero { padding: 62px 7vw 52px; }
    .hero > p:last-child { font-size: 16px; }
    .marketplace { width: min(100% - 36px, 620px); padding: 52px 0 66px; }
    .section-heading { align-items: start; flex-direction: column; gap: 10px; }
    .promotion-card { grid-template-columns: 1fr; border-radius: 18px; }
    .product-image { min-height: 300px; padding: 15px; }
    .product-info { min-height: auto; padding: 30px 24px; }
    .details { grid-template-columns: 1fr; gap: 26px; }
  }
</style>