---
import SiteHeader from '../components/SiteHeader.astro';
import CoverageAndCta from '../components/CoverageAndCta.astro';

const promotions = [
  {
    id: '3-camaras-3k',
    brand: 'TP-Link',
    name: 'Paquete de 3 cámaras 3K para exterior',
    price: '$7,999 MXN',
    installation: 'Instalación de 3 cámaras todo incluido',
    image: '/images/promotions/tplink-3-camaras-3k-exterior.webp',
    images: undefined,
    alt: 'Tres cámaras TP-Link Tapo 3K para exterior',
    features: ['Resolución 3K (5 MP)', 'Visión nocturna a color', 'Detección de movimiento', 'Audio bidireccional', 'Almacenamiento en nube o microSD', 'Resistentes a la intemperie'],
    includes: ['3 cámaras TP-Link para exterior', 'Instalación y material necesario', 'Configuración en dispositivos móviles', 'Almacenamiento', '1 año de garantía por escrito'],
    message: 'Hola SILO,%20quiero%20solicitar%20la%20promoción%20de%203%20cámaras%20TP-Link%203K',
  },
  {
    id: 'camara-cerradura',
    brand: 'TP-Link + Yale',
    name: 'Cámara exterior 2K + cerradura inteligente',
    price: '$6,999 MXN',
    installation: 'Instalación de cámara y cerradura incluida',
    image: '/images/promotions/tapo-yale-2k-cerradura.webp',
    images: undefined,
    alt: 'Cámara exterior TP-Link 2K y cerradura inteligente Yale',
    features: ['Cámara exterior TP-Link con resolución 2K', 'Visión nocturna a color', 'Audio bidireccional', 'Cerradura digital Yale con teclado táctil', 'Acceso y control desde la aplicación'],
    includes: ['1 cámara exterior 2K y 1 cerradura inteligente', 'Instalación y material necesario', 'Configuración en dispositivos móviles', 'Almacenamiento para la cámara', '1 año de garantía por escrito'],
    message: 'Hola SILO,%20quiero%20solicitar%20la%20promoción%20de%20cámara%20exterior%202K%20y%20cerradura%20inteligente',
  },
  {
    id: '2-camaras-3k-interior-exterior',
    brand: 'TP-Link',
    name: '2 cámaras 3K: exterior + interior',
    price: '$5,999 MXN',
    installation: 'Instalación de 2 cámaras todo incluido',
    image: '/images/promotions/tplink-2-camaras-3k-interior-exterior.webp',
    images: undefined,
    alt: 'Cámara exterior TP-Link 3K y cámara interior TP-Link 3K',
    features: ['Resolución 3K (5 MP)', 'Visión nocturna a color', 'Detección de movimiento', 'Audio bidireccional', 'Almacenamiento en nube o microSD'],
    includes: ['1 cámara TP-Link 3K para exterior', '1 cámara TP-Link 3K para interior', 'Equipo, instalación y material necesario', 'Almacenamiento', 'Configuración en dispositivos móviles', '1 año de garantía por escrito'],
    message: 'Hola SILO,%20quiero%20solicitar%20la%20promoción%20de%202%20cámaras%20TP-Link%203K%20para%20interior%20y%20exterior',
  },
  {
    id: '2-camaras-1080p',
    brand: 'TP-Link',
    name: 'Paquete de 2 cámaras 1080p para exterior',
    price: '$5,499 MXN',
    installation: 'Instalación de 2 cámaras todo incluido',
    image: '/images/promotions/tplink-2-camaras-1080p-exterior.webp',
    images: undefined,
    alt: 'Dos cámaras TP-Link 1080p para exterior',
    features: ['Resolución 1080p', 'Visión nocturna a color', 'Detección de movimiento', 'Audio bidireccional', 'Almacenamiento en nube o microSD', 'Resistentes a la intemperie'],
    includes: ['2 cámaras TP-Link para exterior', 'Instalación y material necesario', 'Configuración en dispositivos móviles', 'Almacenamiento', '1 año de garantía por escrito'],
    message: 'Hola SILO,%20quiero%20solicitar%20la%20promoción%20de%202%20cámaras%20TP-Link%201080p',
  },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promociones de cámaras de seguridad | SILO</title>
    <meta name="description" content="Encuentra promociones de cámaras, cerraduras y paquetes de seguridad con instalación incluida. Equipo, configuración y garantía en CDMX y Estado de México." />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="marketplace" aria-labelledby="promociones-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Promociones SILO</p>
            <h1 id="promociones-title">Promociones con instalación incluida</h1>
            <p class="intro">Elige un paquete y recibe equipo, instalación, configuración, almacenamiento y garantía en un solo precio.</p>
          </div>
          <span class="count">{promotions.length} promociones disponibles</span>
        </div>

        <div class="product-grid">
          {promotions.map((promotion) => (
            <article class="promotion-card">
              <div class:list={['product-image', { 'product-image-pair': promotion.images }]}>
                {promotion.images ? (
                  <div class="product-pair">
                    {promotion.images.map((image, index) => <img src={image} alt={index === 0 ? 'Cámara exterior TP-Link 3K' : 'Cámara interior TP-Link 3K'} />)}
                  </div>
                ) : (
                  <img src={promotion.image} alt={promotion.alt} />
                )}
              </div>
              <div class="product-copy">
                <p class="badge">Promoción</p>
                <p class="brand">{promotion.brand}</p>
                <h2>{promotion.name}</h2>
                <p class="price">{promotion.price}</p>
                <p class="included-line">{promotion.installation}</p>
                <button class="details-link" type="button" data-dialog-id={`details-${promotion.id}`}>Ver más</button>
                <a class="quote-button" href={`https://wa.me/526722671419?text=${promotion.message}`}>Solicitar promoción</a>
              </div>

              <dialog class="product-dialog" id={`details-${promotion.id}`} aria-labelledby={`details-title-${promotion.id}`}>
                <form method="dialog"><button class="dialog-close" aria-label="Cerrar detalles">×</button></form>
                <div class:list={['dialog-product-image', { 'dialog-product-image-pair': promotion.images }]}>
                {promotion.images ? (
                  <div class="product-pair">
                    {promotion.images.map((image, index) => <img src={image} alt={index === 0 ? 'Cámara exterior TP-Link 3K' : 'Cámara interior TP-Link 3K'} />)}
                  </div>
                ) : (
                  <img src={promotion.image} alt={promotion.alt} />
                )}
              </div>
                <div class="dialog-copy">
                  <p class="brand">{promotion.brand}</p>
                  <h2 id={`details-title-${promotion.id}`}>{promotion.name}</h2>
                  <p class="dialog-price">{promotion.price}</p>
                  <p class="dialog-installation">{promotion.installation}</p>
                  <div class="dialog-details">
                    <div>
                      <h3>Características</h3>
                      <ul>{promotion.features.map((feature) => <li>{feature}</li>)}</ul>
                    </div>
                    <div>
                      <h3>Incluye</h3>
                      <ul>{promotion.includes.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  </div>
                  <a class="dialog-quote-button" href={`https://wa.me/526722671419?text=${promotion.message}`}>Solicitar promoción</a>
                </div>
              </dialog>
            </article>
          ))}
        </div>
      </section>

      <CoverageAndCta />
    </main>
    <script>
      document.querySelectorAll('.details-link').forEach((button) => {
        button.addEventListener('click', () => {
          const dialog = document.getElementById(button.dataset.dialogId);
          dialog?.showModal();
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;color:#090909;font-family:Inter,Arial,sans-serif;background:#fff}
  :global(a){color:inherit;text-decoration:none}
  .marketplace{width:min(1450px,94vw);margin:0 auto;padding:62px 0 92px}
  .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:36px;padding-bottom:27px;border-bottom:1px solid #d9d9d9}
  .eyebrow,.brand{margin:0;color:#e61e32;font-size:12px;font-weight:750;letter-spacing:.13em;text-transform:uppercase}
  h1,h2,h3{margin:0}
  h1{max-width:760px;margin-top:15px;font-size:clamp(34px,4vw,58px);font-weight:600;line-height:1.04;letter-spacing:-.055em}
  .intro{max-width:660px;margin:18px 0 0;color:#5e5e5e;font-size:16px;line-height:1.55}
  .count{color:#666;font-size:14px;white-space:nowrap}
  .product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .promotion-card{display:flex;min-height:465px;flex-direction:column;overflow:hidden;border:1px solid #e0e0e0;border-radius:18px;background:#fff}
  .product-image{display:flex;height:240px;align-items:center;justify-content:center;padding:12px;background:#f5f5f5}
  .product-image img{display:block;width:100%;height:100%;object-fit:contain}
  .product-image-pair,.dialog-product-image-pair{padding:18px}
  .product-image-pair .product-pair{height:68%;max-width:80%;grid-template-columns:repeat(2,minmax(0,1fr));gap:18%}
  .dialog-product-image-pair .product-pair{height:72%;max-width:72%;grid-template-columns:repeat(2,minmax(0,1fr));gap:18%}
  .product-pair{align-items:center;display:grid;height:100%;justify-content:center;margin:0 auto;width:100%}
  .product-pair img{display:block;height:100%;max-height:100%;object-fit:contain;width:100%}
  .product-copy{display:flex;flex:1;flex-direction:column;padding:18px}
  .badge{align-self:flex-start;margin:0 0 14px;padding:6px 9px;border-radius:5px;background:#e61e32;color:#fff;font-size:11px;font-weight:700}
  .brand{margin-bottom:8px;font-size:10px}
  .product-copy h2{font-size:19px;font-weight:600;line-height:1.17;letter-spacing:-.035em}
  .price{margin:17px 0 4px;font-size:29px;font-weight:400;letter-spacing:-.05em}
  .included-line{margin:0;color:#606060;font-size:13px;line-height:1.35}
  .details-link{align-self:flex-start;margin:14px 0 18px;padding:0;border:0;background:transparent;color:#090909;cursor:pointer;font:inherit;font-size:13px;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
  .quote-button,.dialog-quote-button{display:flex;align-items:center;justify-content:center;margin-top:auto;padding:13px 15px;border-radius:999px;background:linear-gradient(180deg,#3d3d3d,#050505);box-shadow:0 7px 12px rgba(0,0,0,.15),inset 0 1px 1px rgba(255,255,255,.25);color:#fff;font-size:13px;font-weight:600;transition:transform .2s ease}
  .quote-button:hover,.dialog-quote-button:hover{color:#fff;transform:translateY(-1px)}
  .product-dialog{width:min(880px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow:auto;padding:0;border:0;border-radius:20px;box-shadow:0 24px 80px rgba(0,0,0,.28);color:#090909}
  .product-dialog::backdrop{background:rgba(9,9,9,.62)}
  .product-dialog form{position:sticky;z-index:3;top:14px;float:right;margin:-48px 14px 0 0}
  .dialog-close{display:flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:1px solid #ddd;border-radius:50%;background:#fff;color:#090909;cursor:pointer;font-size:25px;line-height:1}
  .dialog-product-image{display:flex;min-height:330px;align-items:center;justify-content:center;padding:25px;background:#f5f5f5}
  .dialog-product-image img{display:block;max-width:100%;width:100%;height:290px;object-fit:contain}
  .dialog-copy{padding:32px 38px 40px}
  .dialog-copy h2{max-width:620px;font-size:clamp(25px,3vw,38px);font-weight:600;line-height:1.08;letter-spacing:-.045em}
  .dialog-price{margin:21px 0 4px;font-size:28px;font-weight:400;letter-spacing:-.04em}
  .dialog-installation{margin:0;color:#555;font-size:13px}
  .dialog-details{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin:25px 0 30px;padding:23px 0;border-top:1px solid #ddd;border-bottom:1px solid #ddd}
  .dialog-details h3{margin-bottom:10px;font-size:14px;font-weight:650}
  ul{display:grid;gap:8px;margin:0;padding:0;list-style:none;color:#585858;font-size:13px;line-height:1.38}
  li{position:relative;padding-left:15px}
  li::before{position:absolute;left:0;color:#e61e32;content:'•'}
  .dialog-quote-button{display:inline-flex;margin-top:0;padding:14px 20px}
  @media(max-width:1050px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:760px){.marketplace{width:min(100% - 36px,560px);padding:46px 0 64px}.section-heading{align-items:flex-start;flex-direction:column;gap:14px;margin-bottom:24px}.intro{font-size:15px}.product-grid{grid-template-columns:1fr}.promotion-card{min-height:0}.product-image{height:270px}.product-copy{padding:22px}.product-copy h2{font-size:22px}.price{font-size:31px}.dialog-product-image{min-height:240px;padding:16px}.dialog-product-image img{height:220px}.dialog-copy{padding:28px 22px 32px}.dialog-details{grid-template-columns:1fr;gap:24px}.product-dialog form{margin-top:-46px}}
</style>