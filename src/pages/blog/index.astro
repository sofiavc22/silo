---
import SiteHeader from '../../components/SiteHeader.astro';
import CoverageAndCta from '../../components/CoverageAndCta.astro';
import { blogPosts } from '../../data/blog';
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog de seguridad para el hogar | SILO</title>
    <meta name="description" content="Guías prácticas sobre cámaras de seguridad, timbres inteligentes, cerraduras digitales y casa inteligente para tu hogar." />
    {siteUrl && <link rel="canonical" href={`${siteUrl}/blog`} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content="Blog de seguridad para el hogar | SILO" />
    <meta property="og:description" content="Consejos claros para elegir, instalar y aprovechar la seguridad inteligente en tu hogar." />
    {siteUrl && <meta property="og:url" content={`${siteUrl}/blog`} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <p class="eyebrow">BLOG SILO</p>
        <h1>Seguridad inteligente, explicada sin vueltas.</h1>
        <p>Guías para elegir cámaras, proteger los accesos de tu casa y tomar mejores decisiones antes de instalar.</p>
      </section>
      <section class="posts" aria-label="Artículos del blog">
        {blogPosts.map((post) => (
          <article>
            <p class="meta">{post.category} <span>·</span> {post.readTime}</p>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p class="description">{post.description}</p>
            <a class="read-link" href={`/blog/${post.slug}`}>Leer artículo <span>→</span></a>
          </article>
        ))}
      </section>
      <CoverageAndCta />
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;font-family:Inter,Arial,sans-serif;color:#090909}:global(a){color:inherit;text-decoration:none}.hero{padding:120px 12vw 88px;border-bottom:1px solid #dedede}.eyebrow,.meta{color:#e61e32;font-size:11px;font-weight:800;letter-spacing:1.8px}.hero h1{max-width:820px;margin:18px 0 24px;font-size:clamp(44px,6vw,84px);line-height:.98;letter-spacing:-4px}.hero>p:last-child{max-width:590px;color:#5d5d5d;font-size:19px;line-height:1.55}.posts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;padding:72px 12vw 120px}.posts article{display:flex;min-height:340px;flex-direction:column;padding:26px 0;border-top:1px solid #aaa}.meta{margin:0 0 22px}.meta span{color:#999;margin:0 5px}.posts h2{margin:0;font-size:28px;line-height:1.12;letter-spacing:-1.3px}.description{color:#5e5e5e;font-size:15px;line-height:1.65}.read-link{margin-top:auto;color:#e61e32;font-size:13px;font-weight:800}.read-link span{margin-left:7px}@media(max-width:800px){.hero{padding:92px 7vw 65px}.hero h1{letter-spacing:-2.5px}.posts{grid-template-columns:1fr;padding:48px 7vw 80px;gap:12px}.posts article{min-height:260px}.posts h2{font-size:26px}}
</style>
