---
import SiteHeader from '../../components/SiteHeader.astro';
import CoverageAndCta from '../../components/CoverageAndCta.astro';
import { blogPosts } from '../../data/blog';
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const articleImages = {
  'donde-instalar-camaras-de-seguridad-casa': '/images/silo-camera-hero.webp',
  'camaras-alambricas-vs-inalambricas': '/images/cameras/tplink-exterior-alambrica-2k.webp',
  'cuanto-cuesta-instalar-camaras-seguridad-cdmx-edomex': '/images/cameras/ring-exterior-alambrica-reflectores-sirena.webp',
};
const [featuredPost, ...otherPosts] = blogPosts;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog de seguridad para el hogar | SILO</title>
    <meta name="description" content="Guías prácticas sobre cámaras de seguridad, timbres inteligentes, cerraduras digitales y casa inteligente para tu hogar." />
    {siteUrl && <link rel="canonical" href={`${siteUrl}/blog`} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content="Blog de seguridad para el hogar | SILO" />
    <meta property="og:description" content="Consejos claros para elegir, instalar y aprovechar la seguridad inteligente en tu hogar." />
    {siteUrl && <meta property="og:url" content={`${siteUrl}/blog`} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> BLOG SILO</p>
          <h1>Protege tu hogar con decisiones más claras.</h1>
          <p>Guías sencillas para elegir cámaras, cuidar los accesos de tu casa y entender qué necesitas antes de instalar.</p>
        </div>
        <a class="featured" href={`/blog/${featuredPost.slug}`}>
          <div class="featured-image"><img src={articleImages[featuredPost.slug]} alt="Cámara de seguridad instalada en una casa" /></div>
          <div class="featured-copy">
            <p>{featuredPost.category} <span>·</span> {featuredPost.readTime}</p>
            <h2>{featuredPost.title}</h2>
            <span class="featured-link">Leer guía <b>→</b></span>
          </div>
        </a>
      </section>
      <section class="posts-section" aria-label="Artículos del blog">
        <div class="section-head"><p class="eyebrow">EMPIEZA AQUÍ</p><p>Consejos útiles para hacer tu casa más segura.</p></div>
        <div class="posts">
        {otherPosts.map((post) => (
          <article>
            <a class="post-image" href={`/blog/${post.slug}`}><img src={articleImages[post.slug]} alt={`Cámara de seguridad: ${post.title}`} loading="lazy" /></a>
            <p class="meta">{post.category} <span>·</span> {post.readTime}</p>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p class="description">{post.description}</p>
            <a class="read-link" href={`/blog/${post.slug}`}>Leer artículo <span>→</span></a>
          </article>
        ))}
        </div>
      </section>
      <CoverageAndCta />
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;font-family:Inter,Arial,sans-serif;color:#090909}:global(a){color:inherit;text-decoration:none}.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:8vw;align-items:center;padding:78px 12vw 82px;background:#f5f5f2}.eyebrow,.meta{color:#e61e32;font-size:10px;font-weight:900;letter-spacing:2px}.eyebrow span{display:inline-block;width:25px;height:2px;margin:0 9px 3px 0;background:#e61e32}.hero h1{max-width:720px;margin:18px 0 25px;font-size:clamp(44px,5.3vw,76px);line-height:.99;letter-spacing:-3.6px}.hero-copy>p:last-child{max-width:570px;margin:0;color:#5d5d5d;font-size:18px;line-height:1.55}.featured{display:block;background:#090909;color:#fff;transition:transform .2s ease,box-shadow .2s ease}.featured:hover{transform:translateY(-4px);box-shadow:0 18px 32px rgba(0,0,0,.16)}.featured-image{height:260px;background:#e9e9e7;overflow:hidden}.featured-image img,.post-image img{width:100%;height:100%;display:block;object-fit:contain;mix-blend-mode:multiply}.featured-copy{padding:25px 28px 27px}.featured-copy p{margin:0 0 14px;color:#f55a6b;font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase}.featured-copy p span{color:#777;margin:0 5px}.featured-copy h2{margin:0 0 24px;font-size:26px;line-height:1.08;letter-spacing:-1.3px}.featured-link{font-size:12px;font-weight:800}.featured-link b{margin-left:7px;color:#e61e32}.posts-section{padding:76px 12vw 112px}.section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:30px;padding-bottom:19px;border-bottom:1px solid #bcbcbc}.section-head .eyebrow{margin:0}.section-head>p:last-child{margin:0;color:#696969;font-size:14px}.posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:50px 32px}.posts article{display:flex;min-height:420px;flex-direction:column}.post-image{height:245px;margin-bottom:24px;border:1px solid #e0e0df;background:#f7f7f6;overflow:hidden}.post-image img{padding:18px;transition:transform .25s ease}.post-image:hover img{transform:scale(1.04)}.meta{margin:0 0 13px}.meta span{color:#999;margin:0 5px}.posts h2{max-width:540px;margin:0;font-size:29px;line-height:1.1;letter-spacing:-1.5px}.description{max-width:560px;color:#5e5e5e;font-size:15px;line-height:1.65}.read-link{margin-top:auto;color:#e61e32;font-size:13px;font-weight:800}.read-link span{margin-left:7px}@media(max-width:900px){.hero{grid-template-columns:1fr;padding:76px 7vw 70px;gap:42px}.featured{max-width:560px}.hero h1{letter-spacing:-2.6px}.posts-section{padding:58px 7vw 80px}.posts{grid-template-columns:1fr;gap:48px}.posts article{min-height:0}.post-image{height:255px}.description{margin-bottom:25px}}@media(max-width:520px){.hero{padding-top:58px}.hero h1{font-size:45px}.featured-image{height:220px}.featured-copy{padding:22px}.featured-copy h2{font-size:24px}.section-head{display:block}.section-head>p:last-child{margin-top:9px}.post-image{height:220px}.posts h2{font-size:26px}}
</style>
