      display: none;
    }
    .menu {
      display: block;
      border: 0;
      background: transparent;
      color: #090909;
      font-size: 22px;
      cursor: pointer;
    }
    .mobile-nav {
      position: fixed;
      z-index: 45;
      top: 70px;
      left: 0;
      right: 0;
      padding: 12px 7vw 22px;
      background: #fff;
      border-bottom: 1px solid #ddd;
      box-shadow: 0 12px 22px rgba(0, 0, 0, 0.08);
    }
    .mobile-nav.open {
      display: grid;
    }
    .mobile-nav a {
      padding: 15px 0;
      border-bottom: 1px solid #eee;
      font-size: 13px;
      font-weight: 600;
    }
    .mobile-nav a:last-child {
      color: #e61e32;
      border-bottom: 0;
    }
  }
</style>
<style>
  .mobile-quote {
    display: none;
  }
  @media (max-width: 700px) {
    :global(body) {
      padding-bottom: 76px;
    }
    .mobile-quote {
      display: flex;
      position: fixed;
      z-index: 60;
      bottom: 14px;
