        },
      },
    },
    {
      params: { slug: "timbres-inteligentes" },
      props: {
        data: {
          title: "Instalación de timbres inteligentes para tu hogar",
          intro: "Ve, escucha y responde a tus visitas desde donde estés.",
          body: "Instalamos timbres inteligentes Ring y Nest para que puedas ver, escuchar y responder a tus visitas aunque no estés en casa. Una forma más cómoda de controlar el acceso a tu hogar.",
          points: [
            "Video en la entrada principal",
            "Comunicación desde tu celular",
            "Alertas cuando alguien toca",
            "Compatibilidad con Alexa según el modelo",
          ],
          catalog: [
            { brand: "Ring", name: "Timbre inteligente con cable", image: "/images/doorbells/ring-con-cable.webp" },
            { brand: "Nest", name: "Timbre inteligente con cable", image: "/images/doorbells/nest-con-cable.jpg" },
            { brand: "TP-Link", name: "Timbre inteligente con cable", image: "/images/doorbells/tplink-con-cable.webp" },
          ],
        },
      },
    },
    {
      params: { slug: "instalacion-cerraduras-digitales" },
      props: {
        data: {
          title: "Instalación de cerraduras digitales para tu hogar",
          intro: "Entra a tu casa sin buscar las llaves.",
          body: "Instalamos cerraduras inteligentes Yale para hacer más sencillo y seguro el acceso a tu hogar. Te ayudamos a elegir el modelo, instalarlo y dejarlo configurado para tu rutina.",
          points: [
            "Acceso inteligente",
            "Control desde el celular en modelos compatibles",
            "Instalación profesional",
            "Diseño premium para tu puerta",
          ],
          catalog: [
            { brand: "Yale", name: "Cerradura digital con manija", image: "/images/locks/yale-manija.webp" },
            { brand: "Yale", name: "Cerradura digital con jaladera", image: "/images/locks/yale-jaladera.jpg" },
            { brand: "TP-Link", name: "Cerradura digital", image: "/images/locks/tplink-digital.webp" },
          ],
        },
      },
    },
    {
      params: { slug: "automatizacion-residencial" },
      props: {
        data: {
          title: "Instalación de casa inteligente y automatización residencial en México",
          intro: "Automatizamos desde una habitación hasta una casa completa.",
          body: "Convertimos casas existentes en hogares inteligentes y también participamos desde la etapa de diseño de una casa nueva. Instalamos y configuramos iluminación, enchufes, sensores y otros dispositivos conectados para crear automatizaciones útiles, fáciles de controlar y pensadas para tu rutina.",
          points: [
            "Automatización de iluminación",
            "Enchufes y dispositivos inteligentes",
            "Sensores y rutinas automáticas",
            "Proyectos para casas existentes o desde diseño",
          ],
        },
      },
    },
  ];
}
const { data } = Astro.props;
const catalogBrands = data.catalog ? [...new Set(data.catalog.map((product) => product.brand))] : [];
const brandAnchor = (brand) => brand.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: data.title,
  description: data.body,
  provider: {
    "@type": "HomeAndConstructionBusiness",
    name: "SILO",
    telephone: "+52 672 267 1419",
  },
  areaServed: Astro.params.slug === "automatizacion-residencial" ? "México" : ["Ciudad de México", "Estado de México"],
  serviceType: data.title,
};
const cameraFaqs = [
  {
    "question": "¿Qué cámaras de seguridad instalan?",
    "answer": "Instalamos cámaras para interior y exterior, tanto alámbricas como inalámbricas. Solo trabajamos con marcas premium y confiables: TP-Link, Google Nest y Amazon Ring."
  },
  {
    "question": "¿Puedo ver las cámaras de seguridad desde mi celular?",
    "answer": "Sí. Configuramos las cámaras y sus grabaciones en tus dispositivos móviles compatibles para que puedas revisar tu hogar, ver video en vivo y recibir alertas desde la aplicación."
  },
  {
    "question": "¿Las cámaras necesitan Wi‑Fi?",
    "answer": "Sí, para enviar alertas, ver la transmisión en vivo y consultar las grabaciones desde la aplicación. Antes de instalar, revisamos que la señal llegue correctamente a cada punto."
  },
  {
    "question": "¿Las cámaras graban todo el tiempo o solo cuando detectan movimiento?",
    "answer": "Las cámaras alámbricas pueden configurarse para grabar 24/7, según el modelo y el servicio elegido. Las cámaras inalámbricas graban eventos cuando detectan movimiento, personas u otra actividad. Nuestro servicio incluye la suscripción de almacenamiento en la nube para guardar los eventos importantes y poder consultarlos después."
  },
  {
    "question": "¿Incluyen instalación y configuración?",
    "answer": "Sí. Instalamos las cámaras, realizamos el cableado o montaje necesario, configuramos la aplicación y dejamos el sistema listo para usarse en tus dispositivos móviles."
  },
  {
    "question": "¿Dónde conviene instalar cámaras de seguridad?",
    "answer": "Normalmente recomendamos cubrir la puerta principal, cochera, accesos laterales, patio y áreas comunes. Revisamos tu casa para recomendar los puntos que necesitan mayor cobertura."
  },
  {
    "question": "¿Las cámaras de seguridad tienen visión nocturna?",
    "answer": "Sí. Los equipos que manejamos cuentan con visión nocturna para que puedas revisar los accesos de tu casa incluso con poca luz."
  },
  {
    "question": "¿Son compatibles con Amazon Alexa y Google Home?",
    "answer": "Sí. Los equipos compatibles se pueden configurar con Amazon Alexa y Google Home para consultar cámaras y controlar funciones disponibles con comandos de voz."
  },
  {
    "question": "¿Puedo agregar más cámaras después?",
    "answer": "Sí. Podemos ampliar tu sistema cuando necesites proteger nuevas áreas de tu hogar."
  },
  {
    "question": "¿Cuánto cuesta instalar cámaras de seguridad?",
    "answer": "Con nosotros, la instalación de una sola cámara comienza desde $3,000 MXN, todo incluido. El precio final depende del número de cámaras, los espacios que necesitas proteger y el tipo de equipo. Seleccionamos y probamos equipos duraderos, con excelente imagen y aplicaciones fáciles de usar."
  }
];
const lockFaqs = [
  { "question": "¿Qué cerraduras inteligentes instalan?", "answer": "Instalamos cerraduras digitales Yale y TP-Link para casas y departamentos. Revisamos tu puerta y te recomendamos un modelo compatible con el tipo de acceso que buscas." },
  { "question": "¿Cómo se puede abrir una cerradura inteligente?", "answer": "Según el modelo, puedes abrirla con código, huella digital o tarjeta. También cuentan con llave física de respaldo para que siempre tengas una alternativa de acceso." },
  { "question": "¿Funcionan si se va la luz?", "answer": "Los modelos cuentan con métodos de respaldo según el equipo, como baterías o llave mecánica. Te explicamos cómo usarlo correctamente al terminar la instalación." },
  { "question": "¿Incluyen instalación y configuración?", "answer": "Sí. Revisamos la compatibilidad, instalamos la cerradura, configuramos el acceso y dejamos todo listo para usarse." },
  { "question": "¿Cuánto cuesta instalar una cerradura inteligente?", "answer": "La instalación de una cerradura inteligente comienza desde $6,000 MXN, todo incluido. El precio final depende del modelo, el tipo de puerta y las adaptaciones necesarias." },
];
const automationFaqs = [
  { "question": "¿Qué se puede automatizar en una casa?", "answer": "Podemos automatizar iluminación, enchufes, sensores, rutinas y otros dispositivos compatibles. El proyecto puede comenzar con funciones sencillas y crecer hasta integrar distintas áreas de la casa." },
  { "question": "¿Pueden convertir una casa existente en una casa inteligente?", "answer": "Sí. Revisamos la instalación y las necesidades de la casa para proponer una solución que aproveche la infraestructura existente y añada automatización de forma ordenada." },
  { "question": "¿Pueden participar desde el diseño de una casa nueva?", "answer": "Sí. Podemos integrarnos desde la etapa de diseño para planear ubicaciones, conexiones, dispositivos y automatizaciones antes de que la obra esté terminada." },
  { "question": "¿Instalan iluminación inteligente?", "answer": "Sí. Podemos automatizar luces, interruptores y escenas para controlar distintos ambientes desde el celular, con voz o mediante rutinas programadas, según los equipos elegidos." },
  { "question": "¿Instalan enchufes y sensores inteligentes?", "answer": "Sí. Instalamos enchufes y sensores compatibles para automatizar acciones, detectar movimiento o condiciones específicas y crear rutinas adaptadas al uso de la casa." },
  { "question": "¿La casa inteligente se puede controlar desde el celular?", "answer": "Sí. Configuramos los dispositivos compatibles para que puedas controlar funciones desde aplicaciones móviles y, cuando el sistema lo permite, mediante asistentes de voz." },
  { "question": "¿Tengo que automatizar toda la casa desde el principio?", "answer": "No. Podemos comenzar con una habitación o con las funciones que más utilizas y diseñar el sistema para ampliarlo después." },
  { "question": "¿Trabajan proyectos de automatización residencial en todo México?", "answer": "Sí. Para proyectos de casa inteligente y automatización residencial ofrecemos cobertura nacional. Revisamos primero el alcance del proyecto para coordinar la instalación." },
];

const doorbellFaqs = [
  {
    "question": "¿Qué timbres inteligentes instalan?",
    "answer": "Instalamos timbres inteligentes para casas y departamentos. Te ayudamos a elegir un equipo según tu puerta, el tipo de conexión disponible y las funciones que quieres usar desde tu celular."
  },
  {
    "question": "¿Puedo ver y hablar con quien toca desde mi celular?",
    "answer": "Sí. Configuramos el timbre en tus dispositivos móviles para que puedas recibir una alerta, ver a la persona en la entrada y hablar con ella desde la aplicación."
  },
  {
    "question": "¿Los timbres inteligentes necesitan Wi‑Fi?",
    "answer": "Sí. El Wi‑Fi permite recibir alertas, ver video en vivo y responder a tus visitas desde la aplicación. Antes de instalar, revisamos que la señal llegue correctamente a tu entrada."
  },
  {
    "question": "¿Funcionan aunque no esté en casa?",
    "answer": "Sí. Puedes recibir alertas y responder desde tu celular estés donde estés, siempre que el timbre tenga conexión a internet."
  },
  {
    "question": "¿Los timbres inteligentes graban video?",
    "answer": "Sí. Según el modelo y el servicio de almacenamiento elegido, pueden guardar eventos como movimiento o cuando alguien toca el timbre para que los revises después."
  },
  {
    "question": "¿Son compatibles con Amazon Alexa y Google Home?",
    "answer": "Sí. Los equipos compatibles pueden configurarse con Amazon Alexa y Google Home para consultar video y controlar funciones disponibles con comandos de voz."
  },
  {
    "question": "¿Pueden instalar un timbre inteligente en mi puerta actual?",
    "answer": "En la mayoría de los casos sí. Revisamos el espacio de instalación, la conexión eléctrica y la señal Wi‑Fi para recomendarte la opción adecuada para tu entrada."
  },
  {
    "question": "¿Incluyen instalación y configuración?",
    "answer": "Sí. Instalamos el timbre, realizamos el montaje o conexión necesaria, configuramos la aplicación y dejamos el equipo listo para usarse en tus dispositivos móviles."
  },
  {
    "question": "¿Cuánto cuesta instalar un timbre inteligente?",
    "answer": "La instalación de un timbre inteligente comienza desde $3,000 MXN, todo incluido. El precio final depende del modelo, la conexión disponible y las características de tu entrada."
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | SILO</title>
    <meta
      name="description"
      content={Astro.params.slug === 'automatizacion-residencial' ? 'Instalación de casa inteligente y automatización residencial en México. Iluminación, enchufes, sensores y proyectos desde casa existente o etapa de diseño.' : `${data.title}. Instalación profesional en CDMX y Estado de México con SILO.`}
    />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${data.title} | SILO`} />
    <meta property="og:description" content={data.intro} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    ></script>
    {Astro.params.slug === 'instalacion-de-camaras-de-seguridad' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: cameraFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
          {
            "@type": "ListItem",
            position: 2,
            name: "Soluciones",
            item: siteUrl ? `${siteUrl}/#soluciones` : undefined,
          },
          { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
        ],
      })}
    ></script>
    {Astro.params.slug === 'timbres-inteligentes' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: doorbellFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    {Astro.params.slug === 'instalacion-cerraduras-digitales' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: lockFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    {Astro.params.slug === 'automatizacion-residencial' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: automationFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />
    <main>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#soluciones">Soluciones</a>
        <span>/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <section class="hero">
        <p class="eyebrow">SILO / SOLUCIONES INTELIGENTES</p>
        <h1>{data.title}</h1>
        <p class="intro">{data.intro}</p>
        <a
          class="button"
          href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20este%20servicio"
        >
          Solicitar cotización
        </a>
      </section>
      <section class="content">
        <div>
          <p class="eyebrow">Pensado para tu hogar</p>
          <h2>{Astro.params.slug === 'timbres-inteligentes' ? 'Instalación de timbres inteligentes para tu hogar' : Astro.params.slug === 'instalacion-de-camaras-de-seguridad' ? 'Instalación de cámaras de seguridad para interior y exterior' : Astro.params.slug === 'instalacion-cerraduras-digitales' ? 'Cerraduras digitales para tu hogar' : Astro.params.slug === 'automatizacion-residencial' ? 'Automatización de iluminación, enchufes y sensores para tu hogar' : `Instalación de ${data.title} para tu hogar`}</h2>
          <p>{data.body}</p>
        </div>
        <div class="points">
          {data.points.map((point, i) => (
            <div>
              <span>0{i + 1}</span>
              <b>{point}</b>
            </div>
          ))}
        </div>
      </section>
      {Astro.params.slug === "instalacion-de-camaras-de-seguridad" && (
        <section class="camera-capabilities" aria-labelledby="camera-capabilities-title">
          <h2 id="camera-capabilities-title">¿Qué puedes hacer con las cámaras?</h2>
          <div class="capability-grid">
            <article class="capability">
              <div class="capability-visual" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none">
                  <rect x="31" y="24" width="45" height="60" rx="8" />
                  <circle cx="53.5" cy="49" r="9" />
                  <path d="M40 71h27" />
                  <path class="capability-accent" d="M83 34c7 6 7 16 0 22M89 28c11 10 11 25 0 35" />
                </svg>
              </div>
              <p>Recibe notificaciones cuando tus cámaras detecten movimiento.</p>
            </article>
            <article class="capability">
              <div class="capability-visual" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none">
                  <rect x="34" y="20" width="52" height="80" rx="8" />
                  <path d="M43 36h34v39H43z" />
                  <path d="M57 79h7" />
                  <path class="capability-accent" d="M50 61c4-9 12-14 20-14s16 5 20 14M56 49c2-5 6-8 11-8s9 3 11 8" />
                </svg>
              </div>
              <p>Ve tu hogar en vivo desde la app cuando lo necesites.</p>
            </article>
            <article class="capability">
              <div class="capability-visual" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none">
                  <path d="M30 31h60v41H56l-14 13V72H30z" />
                  <path d="M52 45v12M68 45v12" />
                  <path d="M45 57c3 7 9 11 15 11s12-4 15-11" />
                  <path class="capability-accent" d="M68 85c6-4 11-9 14-16" />
                </svg>
              </div>
              <p>Habla con quien esté frente a la cámara mediante comunicación bidireccional.</p>
            </article>
            <article class="capability">
              <div class="capability-visual" aria-hidden="true">
