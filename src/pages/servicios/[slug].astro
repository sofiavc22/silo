const { data } = Astro.props;
const isCameraCatalog = Astro.params.slug === "instalacion-de-camaras-de-seguridad";
const catalogBrands = data.catalog ? [...new Set(data.catalog.map((product) => product.brand))] : [];
const brandAnchor = (brand) => brand.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const productIdentifier = (product) => brandAnchor(`${product.brand}-${product.name}-${product.image}`);
const productPrice = (product) => Number((product.price || "").replace(/[^0-9]/g, "")) || 0;
const featureSpecification = (feature) => {
  const value = feature.toLowerCase();
  if (/^\\d+(?:\\.\\d+)?\\s?(mp|k)$/i.test(feature)) return ["Resolución", feature];
  if (value === "1080p") return ["Resolución", "1080p"];
  if (value.startsWith("resolución")) return ["Resolución", feature.replace(/^Resolución\s*/i, "")];
  if (value.includes("doble lente")) return ["Lentes y resolución", feature];
  if (value.includes("visión nocturna")) return ["Visión nocturna", feature.replace(/^Visión nocturna\s*/i, "")];
  if (value.includes("audio")) return ["Audio", "Bocina y micrófono bidireccionales"];
  if (value.includes("alarma")) return ["Alarma", "Sí, integrada"];
  if (value.includes("ángulo") || value.includes("360")) return ["Ángulo", feature.replace(/^Ángulo de\s*/i, "")];
  if (value.includes("memoria") || value.includes("almacenamiento")) return ["Almacenamiento", feature];
  if (value.includes("alexa") || value.includes("google home") || value.includes("apple home")) return ["Compatible con", feature];
  return ["Características", feature];
};
const catalogGroups = data.catalog
  ? isCameraCatalog
    ? [{ id: "catalogo-de-camaras", products: data.catalog }]
    : catalogBrands.map((brand) => ({
        id: brandAnchor(brand),
        brand,
        products: data.catalog.filter((product) => product.brand === brand),
      }))
  : [];
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const serviceSchema = {
