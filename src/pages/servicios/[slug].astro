            {
              brand: "TP-Link",
              name: "Exterior alámbrica 2K",
              image: "/images/cameras/tplink-exterior-alambrica-2k.webp",
              price: "$3,599 MXN",
              connection: "Conexión por cable",
              features: ["Resolución 2K", "Visión nocturna a color", "Audio bidireccional", "Alarma integrada", "360°", "Memoria incluida", "Alexa y Google Home"],
            },
            {
              brand: "TP-Link",
              name: "Exterior alámbrica 3K",
              image: "/images/cameras/tplink-exterior-alambrica-3k.webp",
              price: "$3,699 MXN",
              connection: "Conexión por cable",
              features: ["Resolución 3K", "Visión nocturna a color", "Audio bidireccional", "Alarma integrada", "360°", "Memoria incluida", "Alexa y Google Home"],
            },
            {
              brand: "TP-Link",
              name: "Exterior doble lente 2K",
              image: "/images/cameras/tplink-exterior-alambrica-doble-lente-2k.webp",
              price: "$3,999 MXN",
              connection: "Conexión inalámbrica",
              features: ["Doble lente 2K", "Visión nocturna a color", "Audio bidireccional", "Alarma integrada", "360°", "Memoria incluida", "Alexa y Google Home"],
            },
            {
              brand: "TP-Link",
              name: "Exterior inalámbrica solar 2K",
              image: "/images/cameras/tplink-exterior-inalambrica-solar-2k.webp",
              price: "$4,299 MXN",
              connection: "Conexión inalámbrica",
              features: ["Resolución 2K", "Visión nocturna a color", "Audio bidireccional", "Alarma integrada", "360°", "Memoria incluida", "Alexa y Google Home"],
            },
            {
              brand: "TP-Link",
              name: "Interior alámbrica 2K",
              image: "/images/cameras/tplink-interior-alambrica-2k.webp",
