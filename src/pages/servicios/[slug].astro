---
import CoverageAndCta from '../../components/CoverageAndCta.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: "camaras-ring-nest" },
      props: {
        data: {
          title: "Cámaras de seguridad para interior y exterior",
          intro: "Ve lo que sucede en tu hogar, estés donde estés.",
          body: "Instalamos y configuramos cámaras de seguridad para que puedas recibir alertas, revisar tu propiedad y consultar lo que ocurre desde tu celular. Diseñamos la ubicación de cada cámara para cubrir los accesos y espacios que más te importan.",
          points: [
            "Cámaras para interior y exterior",
            "Instalación en dispositivos móviles",
            "Instalación limpia y profesional",
            "Almacenamiento en la nube incluida",
          ],
          catalog: [
            {
              brand: "Ring",
              name: "Exterior alámbrica con reflectores y sirena",
              image:
                "/images/cameras/ring-exterior-alambrica-reflectores-sirena.webp",
            },
            {
              brand: "Ring",
              name: "Exterior inalámbrica",
              image: "/images/cameras/ring-exterior-inalambrica.webp",
            },
            {
              brand: "Ring",
              name: "Exterior inalámbrica con luces y sirena",
              image:
                "/images/cameras/ring-exterior-inalambrica-luces-sirena-blanca.webp",
            },
            {
              brand: "Ring",
              name: "Exterior inalámbrica con luces y sirena",
              image:
                "/images/cameras/ring-exterior-inalambrica-luces-sirena-negra.webp",
            },
            {
              brand: "Ring",
              name: "Interior alámbrica",
              image: "/images/cameras/ring-interior-alambrica-blanca.webp",
            },
            {
              brand: "Ring",
              name: "Interior alámbrica",
              image: "/images/cameras/ring-interior-alambrica-negra.webp",
            },
            {
              brand: "Nest",
              name: "Exterior alámbrica 2K HDR",
              image: "/images/cameras/nest-exterior-alambrica-2k-hdr.webp",
            },
            {
              brand: "Nest",
              name: "Exterior alámbrica con reflector",
              image: "/images/cameras/nest-exterior-alambrica-reflector.jpg",
            },
            {
              brand: "Nest",
              name: "Exterior inalámbrica",
              image: "/images/cameras/nest-exterior-inalambrica.webp",
            },
            {
              brand: "Nest",
              name: "Interior inalámbrica",
              image: "/images/cameras/nest-interior-inalambrica.webp",
            },
          ],
        },
      },
    },
    {
      params: { slug: "timbres-inteligentes" },
      props: {
        data: {
          title: "Timbres inteligentes",
          intro: "Tu puerta te avisa quién llegó.",
          body: "Instalamos timbres inteligentes Ring y Nest para que puedas ver, escuchar y responder a tus visitas aunque no estés en casa. Una forma más cómoda de controlar el acceso a tu hogar.",
          points: [
            "Video en la entrada principal",
            "Comunicación desde tu celular",
            "Alertas cuando alguien toca",
            "Compatibilidad con Alexa según el modelo",
          ],
        },
      },
    },
    {
      params: { slug: "cerraduras-yale" },
      props: {
        data: {
          title: "Cerraduras inteligentes Yale",
          intro: "Entra a tu casa sin buscar las llaves.",
          body: "Instalamos cerraduras inteligentes Yale para hacer más sencillo y seguro el acceso a tu hogar. Te ayudamos a elegir el modelo, instalarlo y dejarlo configurado para tu rutina.",
          points: [
            "Acceso inteligente",
            "Control desde el celular en modelos compatibles",
            "Instalación profesional",
            "Diseño premium para tu puerta",
          ],
        },
      },
    },
    {
      params: { slug: "automatizacion-residencial" },
      props: {
        data: {
          title: "Automatización residencial",
          intro: "Haz que tu casa responda a ti.",
          body: "Conectamos tus dispositivos para que puedas controlar funciones de tu hogar desde tu celular o con comandos de voz. Creamos una solución ordenada, fácil de usar y adaptada a tu espacio.",
          points: [
            "Control por voz con Alexa",
            "Rutinas para tu hogar",
            "Dispositivos conectados",
            "Configuración personalizada",
          ],
        },
      },
    },
  ];
}
const { data } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: data.title,
  description: data.body,
  provider: {
    "@type": "HomeAndConstructionBusiness",
    name: "SILO",
    telephone: "+52 672 267 1419",
  },
  areaServed: ["Ciudad de México", "Estado de México"],
  serviceType: data.title,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | SILO</title>
    <meta
      name="description"
      content={`${data.title}. Instalación profesional en CDMX y Estado de México con SILO.`}
    />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${data.title} | SILO`} />
    <meta property="og:description" content={data.intro} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
          {
            "@type": "ListItem",
            position: 2,
            name: "Soluciones",
            item: siteUrl ? `${siteUrl}/#soluciones` : undefined,
          },
          { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
        ],
      })}
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <a class="logo" href="/">
        SILO<span>.</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/servicios/camaras-ring-nest">Cámaras</a>
        <a href="/servicios/timbres-inteligentes">Timbres</a>
        <a href="/servicios/cerraduras-yale">Cerraduras</a>
        <a href="/servicios/automatizacion-residencial">Automatización</a>
        <a href="/#zonas">Cobertura</a>
      </nav>
      <a class="call" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20una%20instalación">
        Cotizar ahora
      </a>
      <button
        class="menu"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        ☰
      </button>
    </header>
    <nav class="mobile-nav" aria-label="Navegación móvil">
      <a href="/servicios/camaras-ring-nest">Cámaras de seguridad</a>
      <a href="/servicios/timbres-inteligentes">Timbres inteligentes</a>
      <a href="/servicios/cerraduras-yale">Cerraduras inteligentes</a>
      <a href="/servicios/automatizacion-residencial">
        Automatización residencial
      </a>
      <a href="/#zonas">Cobertura</a>
      <a href="https://wa.me/526722671419">Hablar por WhatsApp</a>
    </nav>
    <main>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#soluciones">Soluciones</a>
        <span>/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <section class="hero">
        <p class="eyebrow">SILO / SOLUCIONES INTELIGENTES</p>
        <h1>{data.title}</h1>
        <p class="intro">{data.intro}</p>
        <a
          class="button"
          href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20este%20servicio"
        >
          Solicitar cotización
        </a>
      </section>
      <section class="content">
        <div>
          <p class="eyebrow">Pensado para tu hogar</p>
          <h2>Instalación de {data.title} para tu hogar</h2>
          <p>{data.body}</p>
        </div>
        <div class="points">
          {data.points.map((point, i) => (
            <div>
              <span>0{i + 1}</span>
              <b>{point}</b>
            </div>
          ))}
        </div>
      </section>
      {data.catalog && (
        <section class="catalog">
          <div class="catalog-head">
            <p class="eyebrow">Equipos disponibles</p>
            <h2>Las mejores cámaras de seguridad para interior y exterior</h2>
            <p>
              Te ayudamos a elegir el modelo y realizamos la instalación y
              configuración completa.
            </p>
          </div>
          {["Ring", "Nest"].map((brand) => (
            <div class="brand-group">
              <h3>{brand}</h3>
              {brand === "Ring" ? (
                <div class="brand-includes">
                  <p>Incluye con suscripción Ring Protect</p>
                  <ul>
                    <li>Hasta 180 días de reproducción de video</li>
                    <li>Alertas de personas, paquetes y vehículos</li>
                    <li>Vista en vivo extendida</li>
                    <li>Modos de dispositivo y más</li>
                  </ul>
                </div>
              ) : (
                <div class="brand-includes">
                  <p>Incluye con suscripción Google Home Premium</p>
                  <ul>
                    <li>30 días de historial de video de eventos</li>
                    <li>Gemini Live en bocinas y pantallas</li>
                    <li>Creación sencilla de automatizaciones</li>
                    <li>Detección de rostros conocidos y sonidos</li>
                    <li>Detección de la puerta de la cochera</li>
                    <li>Llamadas de emergencia</li>
                  </ul>
                </div>
              )}
              <div class="product-grid">
                {data.catalog
                  .filter((product) => product.brand === brand)
                  .map((product) => (
                    <article class="product-card">
                      <div class="product-image">
                        <img
                          src={product.image}
                          alt={`Cámara ${product.brand} ${product.name}`}
                          loading="lazy"
                        />
                      </div>
                      <p>{product.brand}</p>
                      <h4>{product.name}</h4>
                      <a
                        href={`https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20la%20cámara%20${encodeURIComponent(`${product.brand} ${product.name}`)}`}
                      >
                        Cotizar instalación
                      </a>
                    </article>
                  ))}
              </div>
            </div>
          ))}
        </section>
      )}
      <CoverageAndCta />
    </main>
    <footer>
      <a class="logo" href="/">
        SILO<span>.</span>
      </a>
      <span>CDMX · Estado de México</span>
    </footer>
    <script>
      const menuButton = document.querySelector(".menu");
      const mobileNav = document.querySelector(".mobile-nav");
      menuButton?.addEventListener("click", () => {
        const open = mobileNav?.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(open));
      });
      mobileNav?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => {
          mobileNav.classList.remove("open");
          menuButton?.setAttribute("aria-expanded", "false");
        }),
      );
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    color: #090909;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 82px;
    border-bottom: 1px solid #ddd;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7vw;
  }
  header nav {
    display: flex;
    gap: 20px;
    font-size: 11px;
    font-weight: 700;
  }
  header nav a:hover {
    color: #e61e32;
  }
  .logo {
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -2px;
  }
  .logo span {
    color: #e61e32;
  }
  .call {
    display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border-radius:999px;background:linear-gradient(180deg,#f34a5c,#e61e32 48%,#bd1023);box-shadow:0 6px 11px rgba(0,0,0,.16);color:#fff;font-size:12px;font-weight:700;
  }
  .breadcrumbs {
    max-width: 76vw;
    margin: 22px auto -30px;
    font-size: 11px;
    color: #666;
  }
  .breadcrumbs a:hover {
    color: #e61e32;
  }
  .breadcrumbs span {
    margin: 0 7px;
  }
  .hero {
    background: #e61e32;
    color: #fff;
    padding: 125px 12vw 135px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 800;
    margin: 0 0 26px;
  }
  .hero h1 {
    font-size: clamp(48px, 8vw, 105px);
    line-height: 0.96;
    letter-spacing: -5px;
    max-width: 900px;
    margin: 0 0 28px;
  }
  .intro {
    font-size: 20px;
    line-height: 1.5;
    max-width: 600px;
  }
  .button {
    display: inline-flex;
    gap: 35px;
    background: #000;
    color: #fff;
    padding: 18px 22px;
    font-size: 12px;
    font-weight: 800;
    margin-top: 22px;
  }
  .button:hover {
    background: #fff;
    color: #000;
  }
  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10vw;
    padding: 120px 12vw;
  }
  .content h2 {
    font-size: clamp(34px, 4vw, 60px);
    line-height: 1.03;
    letter-spacing: -3px;
    margin: 0 0 25px;
  }
  .content > div > p:last-child {
    font-size: 15px;
    line-height: 1.8;
    color: #666;
    max-width: 520px;
  }
  .points {
    border-top: 1px solid #ccc;
  }
  .points div {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 25px 0;
    border-bottom: 1px solid #ccc;
    font-size: 14px;
  }
  .points span {
    color: #e61e32;
    font-size: 11px;
    font-weight: 800;
  }
  .bottom {
    background: #f5f5f3;
    padding: 80px 12vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .bottom p {
    font-size: 25px;
    font-weight: 800;
    margin: 0;
    letter-spacing: -1px;
  }
  .bottom a {
    font-size: 12px;
    font-weight: 800;
  }
  footer {
    background: #000;
    color: #fff;
    display: flex;
    justify-content: space-between;
    padding: 35px 7vw;
    font-size: 11px;
  }
  footer span {
    color: #999;
  }
  @media (max-width: 700px) {
    header {
      height: 70px;
      padding: 0 7vw;
    }
    header nav {
      display: none;
    }
    .breadcrumbs {
      margin: 16px 7vw -25px;
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hero {
      padding: 85px 7vw;
    }
    .hero h1 {
      letter-spacing: -3px;
    }
    .content {
      display: block;
      padding: 80px 7vw;
    }
    .points {
      margin-top: 60px;
    }
    .bottom {
      display: block;
      padding: 70px 7vw;
    }
    .bottom p {
      margin-bottom: 25px;
    }
    footer {
      display: block;
    }
    footer span {
      display: block;
      margin-top: 20px;
    }
  }
  .hero {
    background: #fff;
    color: #090909;
    border-bottom: 1px solid #ddd;
  }
  .hero .eyebrow {
    color: #e61e32;
  }
  .intro {
    color: #666;
  }
  .button {
    background: #e61e32;
    color: #fff;
  }
  .content {
    background: #fff;
  }
  .bottom {
    background: #fff;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
  }
  .bottom p {
    color: #090909;
  }
  footer {
    background: #fff;
    color: #090909;
    border-top: 1px solid #ddd;
  }
  :global(html),
  :global(body),
  :global(body *) {
    font-family: "Inter", sans-serif;
  }
  h1,
  h2,
  h3 {
    font-weight: 600 !important;
  }
  h1 {
    font-size: clamp(38px, 5vw, 72px) !important;
    line-height: 1.05 !important;
    letter-spacing: -3px !important;
  }
  h2 {
    font-size: clamp(28px, 3vw, 48px) !important;
    line-height: 1.12 !important;
    letter-spacing: -2px !important;
  }
  .catalog {
    padding: 110px 7vw 130px;
    border-top: 1px solid #ddd;
  }
  .catalog-head {
    max-width: 690px;
    margin: 0 5vw 80px;
  }
  .catalog-head > p:last-child {
    font-size: 15px;
    line-height: 1.7;
    color: #666;
    max-width: 530px;
  }
  .brand-group {
    margin: 0 5vw 85px;
  }
  .brand-group h3 {
    font-size: 22px;
    margin: 0 0 26px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ccc;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .product-card {
    min-width: 0;
  }
  .product-image {
    height: 260px;
    border: 1px solid #e5e5e5;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .product-card p {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #e61e32;
    margin: 18px 0 8px;
    text-transform: uppercase;
  }
  .product-card h4 {
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 18px;
    font-weight: 600;
  }
  .product-card a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 16px;
    border-radius: 999px;
    background: linear-gradient(180deg, #3d3d3d, #050505);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    box-shadow:
      0 6px 10px rgba(0, 0, 0, 0.15),
      inset 0 1px 1px rgba(255, 255, 255, 0.23);
  }
  .product-card a:hover {
    background: #e61e32;
  }
  @media (max-width: 700px) {
    .catalog {
      padding: 80px 7vw;
    }
    .catalog-head,
    .brand-group {
      margin-left: 0;
      margin-right: 0;
    }
    .catalog-head {
      margin-bottom: 55px;
    }
    .brand-group {
      margin-bottom: 60px;
    }
    .product-grid {
      grid-template-columns: 1fr 1fr;
      gap: 25px 14px;
    }
    .product-image {
      height: 185px;
      padding: 12px;
    }
    .product-card h4 {
      font-size: 15px;
    }
    .product-card a {
      padding: 10px 12px;
      font-size: 10px;
    }
  }
  .brand-includes {
    background: #f7f7f7;
    padding: 25px 28px;
    margin: -6px 0 36px;
  }
  .brand-includes p {
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 15px;
  }
  .brand-includes ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand-includes li {
    font-size: 13px;
    line-height: 1.45;
    color: #444;
  }
  .brand-includes li:before {
    content: "✓";
    color: #e61e32;
    font-weight: 800;
    margin-right: 10px;
  }
  @media (max-width: 700px) {
    .brand-includes {
      padding: 20px;
      margin-bottom: 28px;
    }
    .brand-includes ul {
      display: block;
    }
    .brand-includes li {
      margin: 0 0 9px;
      font-size: 12px;
    }
  }
  .logo {
    display: inline-flex;
    width: 43px;
    height: 52px;
    background: url("/images/silo-logo.png") center/contain no-repeat;
    font-size: 0;
