    <script>
      const menuButton = document.querySelector(".menu");
      const mobileNav = document.querySelector(".mobile-nav");
      menuButton?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
      });
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.classList.remove("open");
          menuButton?.setAttribute("aria-expanded", "false");
        });
      });
      document.querySelectorAll(".details-link").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = document.getElementById(button.dataset.dialogId);
          dialog?.showModal();
        });
      });
      const marketplaceControls = document.querySelector("[data-marketplace-controls]");
      const cameraGrid = document.querySelector("[data-camera-grid]");
      if (marketplaceControls && cameraGrid) {
        const cards = Array.from(cameraGrid.querySelectorAll("[data-camera-card]"));
        const sortSelect = marketplaceControls.querySelector("[data-camera-sort]");
        const count = marketplaceControls.querySelector("[data-camera-count]");
        const clearButton = marketplaceControls.querySelector("[data-clear-filters]");
        let brand = "all";
        let power = "all";

        const updateCatalog = () => {
          const visibleCards = cards.filter((card) => {
            const matchesBrand = brand === "all" || card.dataset.brand === brand;
            const matchesPower = power === "all" || card.dataset.power === power;
            return matchesBrand && matchesPower;
          });
          const orderedCards = [...visibleCards].sort((first, second) => {
            const firstPrice = Number(first.dataset.price) || Number.MAX_SAFE_INTEGER;
            const secondPrice = Number(second.dataset.price) || Number.MAX_SAFE_INTEGER;
            if (sortSelect.value === "price-asc") return firstPrice - secondPrice;
            if (sortSelect.value === "price-desc") return secondPrice - firstPrice;
            return cards.indexOf(first) - cards.indexOf(second);
          });
          cards.forEach((card) => { card.hidden = !visibleCards.includes(card); });
          orderedCards.forEach((card) => cameraGrid.append(card));
          count.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? "cámara disponible" : "cámaras disponibles"}`;
        };

        marketplaceControls.querySelectorAll("[data-filter-brand]").forEach((button) => {
          button.addEventListener("click", () => {
            brand = button.dataset.filterBrand;
            marketplaceControls.querySelectorAll("[data-filter-brand]").forEach((item) => item.classList.toggle("active", item === button));
            updateCatalog();
          });
        });
        marketplaceControls.querySelectorAll("[data-filter-power]").forEach((button) => {
          button.addEventListener("click", () => {
            power = button.dataset.filterPower;
            marketplaceControls.querySelectorAll("[data-filter-power]").forEach((item) => item.classList.toggle("active", item === button));
            updateCatalog();
          });
        });
        sortSelect.addEventListener("change", updateCatalog);
        clearButton.addEventListener("click", () => {
          brand = "all";
          power = "all";
          sortSelect.value = "recommended";
          marketplaceControls.querySelectorAll("[data-filter-brand='all'], [data-filter-power='all']").forEach((button) => button.classList.add("active"));
          marketplaceControls.querySelectorAll("[data-filter-brand]:not([data-filter-brand='all']), [data-filter-power]:not([data-filter-power='all'])").forEach((button) => button.classList.remove("active"));
          updateCatalog();
        });
        updateCatalog();
      }
    </script>
</body>
