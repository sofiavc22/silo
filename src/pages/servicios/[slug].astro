---
export function getStaticPaths() { return [
  { params: { slug: 'camaras-ring-nest' }, props: { data: { title: 'Cámaras Ring y Nest', intro: 'Ve lo que sucede en tu hogar, estés donde estés.', body: 'Instalamos y configuramos cámaras Ring y Nest para que puedas recibir alertas, revisar tu propiedad y consultar lo que ocurre desde tu celular. Diseñamos la ubicación de cada cámara para cubrir los accesos y espacios que más te importan.', points: ['Visualización desde tu celular', 'Alertas de actividad', 'Instalación limpia y profesional', 'Integración con Alexa según el modelo'] } } },
  { params: { slug: 'timbres-inteligentes' }, props: { data: { title: 'Timbres inteligentes', intro: 'Tu puerta te avisa quién llegó.', body: 'Instalamos timbres inteligentes Ring y Nest para que puedas ver, escuchar y responder a tus visitas aunque no estés en casa. Una forma más cómoda de controlar el acceso a tu hogar.', points: ['Video en la entrada principal', 'Comunicación desde tu celular', 'Alertas cuando alguien toca', 'Compatibilidad con Alexa según el modelo'] } } },
  { params: { slug: 'cerraduras-yale' }, props: { data: { title: 'Cerraduras inteligentes Yale', intro: 'Entra a tu casa sin buscar las llaves.', body: 'Instalamos cerraduras inteligentes Yale para hacer más sencillo y seguro el acceso a tu hogar. Te ayudamos a elegir el modelo, instalarlo y dejarlo configurado para tu rutina.', points: ['Acceso inteligente', 'Control desde el celular en modelos compatibles', 'Instalación profesional', 'Diseño premium para tu puerta'] } } },
  { params: { slug: 'automatizacion-residencial' }, props: { data: { title: 'Automatización residencial', intro: 'Haz que tu casa responda a ti.', body: 'Conectamos tus dispositivos para que puedas controlar funciones de tu hogar desde tu celular o con comandos de voz. Creamos una solución ordenada, fácil de usar y adaptada a tu espacio.', points: ['Control por voz con Alexa', 'Rutinas para tu hogar', 'Dispositivos conectados', 'Configuración personalizada'] } } },
]; }
const { data } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{data.title} | SILO</title><meta name="description" content={`${data.title}. Instalación premium en CDMX y Estado de México con SILO.`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/></head><body><header><a class="logo" href="/">SILO<span>.</span></a><a class="call" href="tel:6722671419">672 267 1419</a></header><main><section class="hero"><p class="eyebrow">SILO / SOLUCIONES INTELIGENTES</p><h1>{data.title}</h1><p class="intro">{data.intro}</p><a class="button" href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20este%20servicio">Solicitar instalación <b>↗</b></a></section><section class="content"><div><p class="eyebrow">Pensado para tu hogar</p><h2>La tecnología correcta, instalada correctamente.</h2><p>{data.body}</p></div><div class="points">{data.points.map((point, i) => <div><span>0{i+1}</span><b>{point}</b></div>)}</div></section><section class="bottom"><p>¿Quieres saber qué solución necesita tu casa?</p><a href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20asesor%C3%ADa">Hablar con SILO →</a></section></main><footer><a class="logo" href="/">SILO<span>.</span></a><span>CDMX · Estado de México</span></footer></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;font-family:Montserrat,Arial,sans-serif;color:#090909}:global(a){color:inherit;text-decoration:none}header{height:82px;border-bottom:1px solid #ddd;display:flex;align-items:center;justify-content:space-between;padding:0 7vw}.logo{font-size:29px;font-weight:900;letter-spacing:-2px}.logo span{color:#e61e32}.call{font-size:12px;font-weight:800}.hero{background:#e61e32;color:#fff;padding:125px 12vw 135px}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;margin:0 0 26px}.hero h1{font-size:clamp(48px,8vw,105px);line-height:.96;letter-spacing:-5px;max-width:900px;margin:0 0 28px}.intro{font-size:20px;line-height:1.5;max-width:600px}.button{display:inline-flex;gap:35px;background:#000;color:#fff;padding:18px 22px;font-size:12px;font-weight:800;margin-top:22px}.button:hover{background:#fff;color:#000}.content{display:grid;grid-template-columns:1fr 1fr;gap:10vw;padding:120px 12vw}.content h2{font-size:clamp(34px,4vw,60px);line-height:1.03;letter-spacing:-3px;margin:0 0 25px}.content>div>p:last-child{font-size:15px;line-height:1.8;color:#666;max-width:520px}.points{border-top:1px solid #ccc}.points div{display:flex;align-items:center;gap:25px;padding:25px 0;border-bottom:1px solid #ccc;font-size:14px}.points span{color:#e61e32;font-size:11px;font-weight:800}.bottom{background:#f5f5f3;padding:80px 12vw;display:flex;justify-content:space-between;align-items:center}.bottom p{font-size:25px;font-weight:800;margin:0;letter-spacing:-1px}.bottom a{font-size:12px;font-weight:800}footer{background:#000;color:#fff;display:flex;justify-content:space-between;padding:35px 7vw;font-size:11px}footer span{color:#999}@media(max-width:700px){header{height:70px;padding:0 7vw}.hero{padding:85px 7vw}.hero h1{letter-spacing:-3px}.content{display:block;padding:80px 7vw}.points{margin-top:60px}.bottom{display:block;padding:70px 7vw}.bottom p{margin-bottom:25px}footer{display:block}footer span{display:block;margin-top:20px}}
  .hero{background:#fff;color:#090909;border-bottom:1px solid #ddd}.hero .eyebrow{color:#e61e32}.intro{color:#666}.button{background:#e61e32;color:#fff}.content{background:#fff}.bottom{background:#fff;border-top:1px solid #ddd;border-bottom:1px solid #ddd}.bottom p{color:#090909}footer{background:#fff;color:#090909;border-top:1px solid #ddd}
</style>
