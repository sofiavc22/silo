<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | SILO</title>
    <meta
      name="description"
      content={Astro.params.slug === 'instalacion-de-camaras-de-seguridad' ? 'Instalamos cámaras de seguridad para exterior e interior. Incluye equipo, instalación, material, configuración en dispositivos móviles y garantía por escrito.' : Astro.params.slug === 'automatizacion-residencial' ? 'Instalación de casa inteligente y automatización residencial en México. Iluminación, enchufes, sensores y proyectos desde casa existente o etapa de diseño.' : `${data.title}. Instalación profesional en CDMX y Estado de México con SILO.`}
    />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${data.title} | SILO`} />
    <meta property="og:description" content={data.intro} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    ></script>
    {Astro.params.slug === 'instalacion-de-camaras-de-seguridad' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: cameraFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
          {
            "@type": "ListItem",
            position: 2,
            name: "Soluciones",
            item: siteUrl ? `${siteUrl}/#soluciones` : undefined,
          },
          { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
        ],
      })}
    ></script>
    {Astro.params.slug === 'timbres-inteligentes' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: doorbellFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    {Astro.params.slug === 'instalacion-cerraduras-digitales' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: lockFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    {Astro.params.slug === 'automatizacion-residencial' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: automationFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      })}></script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />
    <main>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#soluciones">Soluciones</a>
        <span>/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <section class="hero">
        <p class="eyebrow">SILO / SOLUCIONES INTELIGENTES</p>
        <h1>{data.title}</h1>
        <p class="intro">{data.intro}</p>
        <a
          class="button"
          href="https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20este%20servicio"
        >
          Solicitar cotización
        </a>
      </section>
      <section class="content">
        <div>
          <p class="eyebrow">Pensado para tu hogar</p>
          <h2>{Astro.params.slug === 'timbres-inteligentes' ? 'Instalación de timbres inteligentes para tu hogar' : Astro.params.slug === 'instalacion-de-camaras-de-seguridad' ? 'Instalación de cámaras de seguridad para interior y exterior' : Astro.params.slug === 'instalacion-cerraduras-digitales' ? 'Cerraduras digitales para tu hogar' : Astro.params.slug === 'automatizacion-residencial' ? 'Automatización de iluminación, enchufes y sensores para tu hogar' : `Instalación de ${data.title} para tu hogar`}</h2>
          <p>{data.body}</p>
        </div>
        <div class="points">
          {data.points.map((point, i) => (
            <div>
              <span>0{i + 1}</span>
              <b>{point}</b>
            </div>
          ))}
        </div>
      </section>
      {Astro.params.slug === "instalacion-de-camaras-de-seguridad" && (
        <section class="camera-capabilities" aria-labelledby="camera-capabilities-title">
          <h2 id="camera-capabilities-title">¿Qué puedes hacer con las cámaras?</h2>
          <div class="capability-grid">
            <article class="capability">
              <div class="capability-visual">
                <img src="/images/camera-capabilities/notificaciones-v2.jpg" alt="Notificación de movimiento en una cámara de seguridad" loading="lazy" />
              </div>
              <p>Recibe notificaciones cuando tus cámaras detecten movimiento.</p>
            </article>
            <article class="capability">
              <div class="capability-visual">
                <img src="/images/camera-capabilities/en-vivo.jpg" alt="Tableta mostrando cámaras de seguridad en vivo" loading="lazy" />
              </div>
              <p>Ve tu hogar en vivo desde la app cuando lo necesites.</p>
            </article>
            <article class="capability">
              <div class="capability-visual">
                <img src="/images/camera-capabilities/audio-bidireccional.jpg" alt="Persona frente a una cámara en la entrada de una casa" loading="lazy" />
              </div>
              <p>Habla con quien esté frente a la cámara mediante comunicación bidireccional.</p>
            </article>
            <article class="capability">
              <div class="capability-visual">
                <img src="/images/camera-capabilities/videos-eventos.jpg" alt="Reproducción de un video de seguridad en un teléfono" loading="lazy" />
              </div>
              <p>Los videos de eventos de movimiento se guardan en la app durante varios meses, según el dispositivo que elijas.</p>
            </article>
          </div>
        </section>
      )}
      {data.catalog && (
        <section class="catalog">
          <div class="catalog-head">
            <p class="eyebrow">Equipos disponibles</p>
            <h2>{Astro.params.slug === 'timbres-inteligentes' ? 'Timbres inteligentes disponibles para tu hogar' : Astro.params.slug === 'instalacion-cerraduras-digitales' ? 'Cerraduras digitales disponibles para tu hogar' : 'Cámaras de seguridad con instalación incluida'}</h2>
            <p>
              {Astro.params.slug === 'timbres-inteligentes'
                ? 'Trabajamos con TP-Link, Google Nest y Amazon Ring: tres marcas confiables para ver, escuchar y responder a tus visitas desde donde estés.'
                : Astro.params.slug === 'instalacion-cerraduras-digitales'
                  ? 'Trabajamos con Yale y TP-Link para darte opciones de acceso inteligente, configuración sencilla y un acabado limpio en tu puerta.'
                  : 'Elige la cámara que mejor se adapta a tu hogar. El precio publicado incluye la cámara, la instalación, el material, almacenamiento, configuración en dispositivos móviles y 1 año de garantía por escrito.'}
            </p>
            {!isCameraCatalog && (
              <div class="brand-links" aria-label="Ir a equipos por marca">
                {catalogBrands.map((brand) => (
                  <a href={`#${brandAnchor(brand)}`}>{brand === 'Nest' ? 'Google Nest' : brand}</a>
                ))}
              </div>
            )}
            {isCameraCatalog && (
              <div class="marketplace-controls" data-marketplace-controls>
                <div class="marketplace-toolbar">
                  <div class="marketplace-sort">
                    <label for="camera-sort">Ordenar</label>
                    <select id="camera-sort" data-camera-sort>
                      <option value="recommended">Recomendadas</option>
                      <option value="price-asc">Precio: menor a mayor</option>
                      <option value="price-desc">Precio: mayor a menor</option>
                    </select>
                  </div>
                </div>
                <div class="filter-group">
                  <span>Marca</span>
                  <div class="filter-options">
                    <button class="filter-chip active" type="button" data-filter-brand="all">Todas</button>
                    {catalogBrands.map((brand) => <button class="filter-chip" type="button" data-filter-brand={brand}>{brand === 'Nest' ? 'Google Nest' : brand}</button>)}
                  </div>
                </div>
                <div class="filter-group">
                  <span>Alimentación</span>
                  <div class="filter-options">
                    <button class="filter-chip active" type="button" data-filter-power="all">Todas</button>
                    <button class="filter-chip" type="button" data-filter-power="Cable">Cable</button>
                    <button class="filter-chip" type="button" data-filter-power="Baterías">Baterías</button>
                    <button class="filter-chip" type="button" data-filter-power="Solar">Solar</button>
                  </div>
                </div>
                <div class="marketplace-meta"><span data-camera-count></span><button class="clear-filters" type="button" data-clear-filters>Limpiar filtros</button></div>
              </div>
            )}
          </div>
          {catalogGroups.map((group) => (
            <div class:list={["brand-group", { "marketplace-group": isCameraCatalog }]} id={group.id}>
              {group.brand && <h3>{group.brand}</h3>}
              {!isCameraCatalog && group.brand === "Ring" ? (
                <div class="brand-includes">
                  <p>Incluye suscripción Ring Protect</p>
                  <ul>
                    <li>Hasta 180 días de reproducción de video</li>
                    <li>Alertas de personas, paquetes y vehículos</li>
                    <li>Vista en vivo extendida</li>
                    <li>Modos de dispositivo y más</li>
                  </ul>
                </div>
              ) : !isCameraCatalog && group.brand === "Nest" ? (
                <div class="brand-includes">
                  <p>Incluye suscripción Google Home Premium</p>
                  <ul>
                    <li>30 días de historial de video de eventos</li>
                    <li>Gemini Live en bocinas y pantallas</li>
                    <li>Creación sencilla de automatizaciones</li>
                    <li>Detección de rostros conocidos y sonidos</li>
                    <li>Llamadas de emergencia</li>
                  </ul>
                </div>
              ) : !isCameraCatalog && group.brand === "TP-Link" ? (
                <div class="brand-includes">
                  <p>Incluye con tu instalación TP-Link</p>
                  <ul>
                    <li>Tarjeta microSD de 512 GB para almacenamiento local</li>
                  </ul>
                </div>
              ) : null}
              <div class="product-grid" data-camera-grid={isCameraCatalog ? "true" : undefined}>
