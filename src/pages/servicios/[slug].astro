                    <article class:list={['product-card', { 'camera-product-card': isCameraCatalog }]} data-camera-card={isCameraCatalog ? "true" : undefined} data-brand={product.brand} data-power={product.power || "Sin especificar"} data-price={productPrice(product)}>
                      <div class="product-image">
                        <img
                          src={product.image}
                          alt={`${Astro.params.slug === 'timbres-inteligentes' ? 'Timbre inteligente' : Astro.params.slug === 'instalacion-cerraduras-digitales' ? 'Cerradura inteligente' : 'Cámara'} ${product.brand} ${product.name}`}
                          loading="lazy"
                        />
                      </div>
                      <p>{product.brand}</p>
                      <h4>{product.name}</h4>
                      {product.price && (
                        <div class="installed-price">
                          <span class="price-value">{product.price}</span>
                          <span>Instalación de 1 cámara todo incluido</span>
                        </div>
                      )}
                      <div class:list={['product-actions', { 'camera-product-actions': isCameraCatalog }]}>
                        {product.features && <button class="details-link" type="button" data-dialog-id={`details-${productIdentifier(product)}`}>Ver detalles</button>}
                        <a
                          href={`https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20cotizar%20${Astro.params.slug === 'timbres-inteligentes' ? 'el timbre' : Astro.params.slug === 'instalacion-cerraduras-digitales' ? 'la cerradura' : 'la cámara'}%20${encodeURIComponent(`${product.brand} ${product.name}`)}`}
                        >
                          Solicitar instalación
                        </a>
                      </div>
                      {product.features && (
                        <dialog class="product-dialog" id={`details-${productIdentifier(product)}`} aria-labelledby={`details-title-${productIdentifier(product)}`}>
                          <form method="dialog"><button class="dialog-close" aria-label="Cerrar detalles">×</button></form>
                          <div class="dialog-product-image"><img src={product.image} alt={`Cámara ${product.brand} ${product.name}`} /></div>
                          <div class="dialog-copy">
                            <p>{product.brand}</p>
                            <h3 id={`details-title-${productIdentifier(product)}`}>{product.name}</h3>
                            {product.price && <><span class="dialog-price">{product.price}</span><span class="dialog-installation">Instalación de 1 cámara todo incluido</span></>}
                            <table class="specification-table">
                              <tbody>
                                <tr><th>Alimentación</th><td>{product.power}</td></tr>
                                {product.features.map((feature) => {
                                  const [label, value] = featureSpecification(feature);
                                  return <tr><th>{label}</th><td>{value}</td></tr>;
                                })}
                              </tbody>
                            </table>
                            <a href={`https://wa.me/526722671419?text=Hola%20SILO,%20quiero%20solicitar%20la%20instalación%20de%20${encodeURIComponent(`${product.brand} ${product.name}`)}`}>Solicitar instalación</a>
                          </div>
                        </dialog>
                      )}
                    </article>
                  ))}
              </div>
            </div>
          ))}
        </section>
      )}
      {Astro.params.slug === 'automatizacion-residencial' && (
        <section class="automation-options" aria-labelledby="automation-options-title">
          <div class="automation-options-head">
