---
import CoverageAndCta from '../../components/CoverageAndCta.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: "instalacion-de-camaras-de-seguridad" },
      props: {
        data: {
          title: "Cámaras de seguridad para interior y exterior",
          intro: "Ve lo que sucede en tu hogar, estés donde estés.",
