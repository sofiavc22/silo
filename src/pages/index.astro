  .mobile-quote{display:none}@media(max-width:800px){:global(body){padding-bottom:76px}.menu{border:0;background:transparent;padding:0;color:#090909;cursor:pointer}.mobile-nav{position:fixed;z-index:45;top:70px;left:0;right:0;padding:12px 7vw 22px;background:#fff;border-bottom:1px solid #ddd;box-shadow:0 12px 22px rgba(0,0,0,.08)}.mobile-nav.open{display:grid}.mobile-nav a{padding:15px 0;border-bottom:1px solid #eee;font-size:13px;font-weight:600}.mobile-nav a:last-child{border-bottom:0}.mobile-quote{display:flex;position:fixed;z-index:60;bottom:14px;left:7vw;right:7vw;align-items:center;justify-content:center;padding:16px 20px;border-radius:999px;background:linear-gradient(180deg,#f34a5c,#e61e32 48%,#bd1023);box-shadow:0 8px 18px rgba(0,0,0,.24);color:#fff;font-size:13px;font-weight:700}}
