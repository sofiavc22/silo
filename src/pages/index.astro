  .service a{display:inline-flex;align-items:center;justify-content:center;min-width:142px;padding:13px 21px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:linear-gradient(180deg,#3d3d3d 0%,#151515 46%,#020202 100%);box-shadow:0 8px 13px rgba(0,0,0,.18),inset 0 1px 1px rgba(255,255,255,.25);color:#fff;font-size:12px;font-weight:500;line-height:1;transition:transform .2s ease,box-shadow .2s ease}.service a:hover{color:#fff;transform:translateY(-1px);box-shadow:0 10px 16px rgba(0,0,0,.22),inset 0 1px 1px rgba(255,255,255,.28)}
