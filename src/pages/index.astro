---
import SiteHeader from '../components/SiteHeader.astro';
const phone = '6722671419';
const phoneLabel = '672 267 1419';
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const services = [
  { number: '01', title: 'Cámaras de seguridad', slug: 'instalacion-de-camaras-de-seguridad', text: 'Protege interiores y exteriores y revisa tu casa desde el celular.' },
  { number: '02', title: 'Timbres inteligentes', slug: 'timbres-inteligentes', text: 'Mira quién está en tu puerta y responde estés donde estés.' },
  { number: '03', title: 'Cerraduras inteligentes', slug: 'instalacion-cerraduras-digitales', text: 'Controla el acceso a tu hogar con mayor seguridad y comodidad.' },
  { number: '04', title: 'Automatización residencial', slug: 'automatizacion-residencial', text: 'Conecta tu casa y controla luces, accesos y dispositivos fácilmente.' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Instalación de cámaras de seguridad y automatización residencial en CDMX y Estado de México. Cámaras, timbres inteligentes, cerraduras digitales y casa inteligente con SILO." />
    <title>Instalación de cámaras de seguridad y automatización residencial en CDMX | SILO</title>
    {siteUrl && <link rel="canonical" href={`${siteUrl}/`} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Instalación de cámaras de seguridad y automatización residencial | SILO" />
    <meta property="og:description" content="Cámaras de seguridad, timbres inteligentes, cerraduras digitales y automatización residencial en CDMX y Estado de México." />
    {siteUrl && <meta property="og:url" content={`${siteUrl}/`} />}
    {siteUrl && <meta property="og:image" content={`${siteUrl}/images/silo-camera-hero.webp`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: 'SILO', description: 'Instalación de cámaras de seguridad, timbres inteligentes, cerraduras inteligentes y automatización residencial en CDMX y Estado de México.', telephone: '+52 672 267 1419', areaServed: [{ '@type': 'AdministrativeArea', name: 'Ciudad de México' }, { '@type': 'AdministrativeArea', name: 'Estado de México' }], url: siteUrl, priceRange: '$$', contactPoint: { '@type': 'ContactPoint', telephone: '+52 672 267 1419', contactType: 'sales', availableLanguage: 'es-MX' }, hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Soluciones SILO', itemListElement: services.map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.title, description: service.text } })) } })}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader home />

    <main id="inicio">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> SEGURIDAD · CONTROL · TRANQUILIDAD</p>
          <h1>Instalación de cámaras de seguridad y automatización residencial en CDMX y Estado de México</h1>
          <p class="lead">Instalamos, configuramos y dejamos listo el sistema que protege tu hogar todos los días.</p>
          <div class="hero-actions">
            <a class="button button-red" href={`https://wa.me/52${phone}?text=Hola%20SILO,%20quiero%20cotizar%20una%20instalaci%C3%B3n`}>Solicitar cotización</a>
            <a class="text-link" href="/servicios/instalacion-de-camaras-de-seguridad">Conoce los equipos disponibles</a>
          </div>
          <div class="trust-row"><span>INTERIOR</span><span>EXTERIOR</span><span>ACCESO</span><span>CONTROL</span></div>
        </div>
        <div class="hero-visual" aria-label="Instalación de cámara de seguridad residencial">
          <img src="/images/silo-camera-hero.webp" alt="Instalación de una cámara de seguridad en una casa" width="1000" height="1500" fetchpriority="high" />
          <div class="image-caption"><b>Instalación profesional</b><span>Protección lista desde el primer día</span></div>
        </div>
      </section>

      <section class="benefit-strip" aria-label="Beneficios SILO">
        <article><span class="benefit-icon">▱</span><h3>Opciones de pago<br />flexibles</h3><p>Obtén la protección que necesitas con opciones de pago que se adapten a ti.</p></article>
        <article><span class="benefit-icon">◉</span><h3>Monitoreo<br />24/7</h3><p>Protección y control para tu hogar en todo momento, incluso cuando no estás.</p></article>
        <article><span class="benefit-icon">⌁</span><h3>Instalación<br />profesional</h3><p>Nos encargamos de instalar y configurar tu sistema para que funcione desde el primer día.</p></article>
        <article><span class="benefit-icon">⌂</span><h3>Paquetes de hogar<br />inteligente personalizables</h3><p>Diseñamos un sistema de seguridad y automatización que se ajusta a tu hogar.</p></article>
      </section>

      <section class="section" id="soluciones"><div class="section-head"><p class="eyebrow">Nuestras soluciones</p><h2>Servicio de cámaras de seguridad y automatización<br /><span>para casas en CDMX y Estado de México.</span></h2></div><div class="service-grid">{services.map((service) => <article class="service"><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><a href={`/servicios/${service.slug}`} aria-label={`Ver solución: ${service.title}`}>Ver solución</a></article>)}</div></section>

      <figure class="doorbell-scene">
        <img src="/images/silo-timbre-visitante.webp" width="1100" height="1100" loading="eager" fetchpriority="high" decoding="async" alt="Una persona revisa desde el interior de su hogar al visitante en su celular; el recuadro muestra el timbre inteligente Nest instalado en la entrada." />
      </figure>

      <section class="black-section" id="proceso"><div><p class="eyebrow red">La instalación SILO</p><h2>Cómo instalamos cámaras de seguridad, timbres y cerraduras inteligentes</h2></div><div class="steps"><div><b>01</b><h3>Escuchamos</h3><p>Entendemos tu casa, tus rutinas y lo que quieres resolver.</p></div><div><b>02</b><h3>Diseñamos</h3><p>Te recomendamos una solución según tus espacios y necesidades.</p></div><div><b>03</b><h3>Instalamos</h3><p>Configuramos todo para que tu sistema quede listo para usar.</p></div></div></section>

      <section class="coverage" id="zonas"><div><p class="eyebrow">Cobertura</p><h2>Instalamos en Ciudad de México<br />y <em>Estado de México.</em></h2><div class="coverage-map"><iframe title="Mapa de cobertura SILO en Ciudad de México y Estado de México" src="https://www.google.com/maps?q=Ciudad%20de%20M%C3%A9xico%20y%20Estado%20de%20M%C3%A9xico&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div><div class="locations"><p>Estado de México</p><small>Instalamos en los 125 municipios del Estado de México:</small><div><a href="/zonas/huixquilucan">Huixquilucan</a><a href="/zonas/naucalpan">Naucalpan</a><a href="/zonas/metepec">Metepec</a><a href="/zonas/toluca">Toluca</a><a href="/zonas/tlalnepantla">Tlalnepantla</a></div><p>Ciudad de México</p><small>Instalamos en las 16 alcaldías de Ciudad de México:</small><div><a href="/zonas/miguel-hidalgo">Miguel Hidalgo</a><a href="/zonas/benito-juarez">Benito Juárez</a><a href="/zonas/cuauhtemoc">Cuauhtémoc</a><a href="/zonas/alvaro-obregon">Álvaro Obregón</a><a href="/zonas/coyoacan">Coyoacán</a></div></div></section>

      <section class="faq" id="preguntas"><div><p class="eyebrow">Preguntas frecuentes</p><h2>Preguntas frecuentes sobre cámaras de seguridad y automatización residencial</h2></div><div class="faq-list"><details><summary>¿Qué tipo de cámaras de seguridad instalan?</summary><p>Instalamos cámaras para interior y exterior. Trabajamos con Ring, Nest y TP-Link: marcas reconocidas por su calidad de imagen, diseño y aplicaciones fáciles de usar.</p></details><details><summary>¿Puedo ver las cámaras desde mi celular?</summary><p>Sí. Configuramos las cámaras en tus dispositivos móviles para que puedas ver tu hogar y recibir alertas. También incluimos el almacenamiento de las grabaciones en la nube.</p></details><details><summary>¿Cuál es el proceso de instalación?</summary><p>Nos contactas y nos cuentas qué quieres proteger. Te mostramos las mejores opciones para tu casa, elegimos el equipo adecuado y coordinamos la instalación lo más pronto posible.</p></details><details><summary>¿Las cámaras de seguridad funcionan con Alexa?</summary><p>Sí. Los productos que manejamos son compatibles con Alexa y podemos dejarlos configurados para que controles tu sistema con comandos de voz.</p></details><details><summary>¿Qué diferencia hay entre una cerradura inteligente y una cerradura normal?</summary><p>Una cerradura inteligente te permite controlar y administrar el acceso sin depender solo de llaves físicas. Puedes usar códigos, ver quién entra y crear accesos temporales; instalamos cerraduras Yale y las dejamos configuradas para tu rutina.</p></details></div></section>

      <section class="cta" id="contacto"><p class="eyebrow">Tu siguiente paso</p><h2>Haz que tu casa esté<br /><span>segura y conectada 24/7.</span></h2><p>Cuéntanos qué quieres instalar y te orientamos personalmente.</p><a class="button button-red" href={`https://wa.me/52${phone}?text=Hola%20SILO,%20quiero%20informaci%C3%B3n%20sobre%20una%20instalaci%C3%B3n`}>Hablar por WhatsApp</a><a class="cta-phone" href={`tel:${phone}`}>{phoneLabel}</a></section>
    </main>
    <footer><a class="logo" href="#inicio"><img src="/images/silo-logo.png" alt="SILO" /></a><p>Seguridad inteligente y automatización residencial.</p><p>© 2026 SILO · CDMX y Estado de México</p></footer>
    <script>
      const menuButton = document.querySelector('.menu'); const mobileNav = document.querySelector('.mobile-nav');
      menuButton?.addEventListener('click', () => { const open = mobileNav?.classList.toggle('open'); menuButton.setAttribute('aria-expanded', String(open)); });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { mobileNav.classList.remove('open'); menuButton?.setAttribute('aria-expanded', 'false'); }));
    </script>
  </body>
</html>

<style>
  .doorbell-scene{width:min(86vw,900px);margin:0 auto 72px}
  .doorbell-scene img{display:block;width:100%;height:auto;border-radius:16px}
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;font-family:'Inter',Arial,sans-serif;color:#090909;background:#fff}:global(a){color:inherit;text-decoration:none}.topbar{position:sticky;top:0;z-index:50;height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;border-bottom:1px solid #e8e8e8;background:rgba(255,255,255,.96);backdrop-filter:blur(12px)}.logo{font-size:29px;font-weight:900;letter-spacing:-2px}.logo span{color:#e61e32}.topbar nav{display:flex;gap:34px;font-size:12px;font-weight:700}.topbar nav a:hover,.text-link:hover{color:#e61e32}.header-call{font-size:12px;font-weight:800}.menu{display:none}.hero{min-height:700px;background:#f7f7f5;display:grid;grid-template-columns:1fr 1fr;padding:0 5vw;overflow:hidden}.hero-copy{align-self:center;padding:70px 6vw 70px 0}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;color:#666;margin:0 0 25px}.eyebrow span{display:inline-block;width:8px;height:8px;background:#e61e32;border-radius:50%;margin-right:8px}.hero h1{font-size:clamp(53px,6.8vw,105px);line-height:.96;letter-spacing:-6px;margin:0 0 30px;font-weight:900}.hero h1 em,.coverage h2 em{color:#e61e32;font-style:normal}.lead{font-size:16px;line-height:1.75;max-width:510px;color:#4d4d4d}.hero-actions{display:flex;align-items:center;gap:27px;margin-top:38px}.button{display:inline-flex;align-items:center;gap:28px;padding:17px 21px;font-size:12px;font-weight:800}.button-red{background:#e61e32;color:#fff}.button-red:hover{background:#000}.button b{font-size:19px;line-height:0}.text-link{font-size:12px;font-weight:800}.text-link span{color:#e61e32;font-size:20px;margin-left:7px}.trust-row{display:flex;gap:30px;margin-top:65px;font-size:12px;font-weight:900;letter-spacing:1px;color:#888}.hero-visual{position:relative;min-height:600px;background:#e61e32;display:flex;align-items:center;justify-content:center;overflow:hidden}.orbit{position:absolute;border:1px solid rgba(255,255,255,.3);border-radius:50%;width:560px;height:560px}.orbit-two{width:390px;height:390px}.house-card{position:relative;z-index:1;width:280px;height:350px;background:#0b0b0b;color:#fff;padding:30px;box-shadow:18px 18px 0 rgba(0,0,0,.16);transform:rotate(-7deg);display:flex;flex-direction:column;justify-content:flex-end}.camera-lens{position:absolute;top:28px;left:28px;width:72px;height:72px;border:7px solid #fff;border-radius:50%;box-shadow:inset 0 0 0 8px #e61e32}.house-card p{font-size:9px;letter-spacing:2px;color:#aaa}.house-card strong{font-size:24px;line-height:1.1}.house-card small{font-size:10px;line-height:1.5;color:#aaa;margin-top:12px}.status-card,.device-card{position:absolute;background:#fff;display:flex;align-items:center;gap:12px;padding:15px 17px;box-shadow:8px 8px 0 rgba(0,0,0,.15);z-index:2}.status-card{top:20%;right:10%}.device-card{bottom:19%;left:9%}.status-card i{width:9px;height:9px;background:#37bc64;border-radius:50%}.status-card b,.device-card b{font-size:11px;display:block}.status-card small,.device-card small{display:block;color:#777;font-size:9px;margin-top:4px}.device-card>span{font-size:25px;color:#e61e32}.device-card>strong{font-size:16px;color:#37bc64}.statement{padding:145px 12vw 155px;max-width:1000px}.statement h2,.section h2,.black-section h2,.coverage h2,.cta h2{font-size:clamp(35px,5vw,68px);line-height:1.03;letter-spacing:-3px;margin:0 0 25px}.statement>p:last-child{font-size:17px;line-height:1.7;color:#666;max-width:500px}.section{padding:100px 5vw 150px;background:#f7f7f5}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:75px}.section h2 span,.cta h2 span{color:#999}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #ccc}.service{padding:25px 23px 20px 0;border-right:1px solid #ccc;min-height:275px;margin-right:25px}.service:last-child{border:0}.service-number{font-size:12px;font-weight:800;color:#e61e32}.service h3{font-size:20px;line-height:1.1;margin:58px 0 14px}.service p{font-size:13px;line-height:1.65;color:#666;max-width:220px;min-height:65px}.service a{font-size:11px;font-weight:800}.service a span{color:#e61e32;font-size:17px;margin-left:7px}.black-section{background:#090909;color:#fff;padding:115px 5vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.red{color:#e61e32}.black-section h2{max-width:480px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.steps>div{border-top:1px solid #555;padding-top:20px}.steps b{color:#e61e32;font-size:12px}.steps h3{font-size:18px;margin:45px 0 12px}.steps p{font-size:12px;line-height:1.7;color:#aaa}.coverage{padding:125px 5vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.locations>p{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;border-top:1px solid #ccc;padding-top:18px;margin-top:0}.locations>div{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:38px}.locations span{border:1px solid #ddd;padding:10px 12px;font-size:11px;font-weight:600}.locations small{font-size:11px;line-height:1.6;color:#777}.cta{background:#e61e32;color:#fff;text-align:center;padding:125px 20px}.cta .eyebrow{color:#fff}.cta h2{margin-bottom:17px}.cta h2 span{color:#000}.cta p:not(.eyebrow){font-size:15px;margin-bottom:32px}.cta-phone{display:block;font-size:14px;font-weight:800;margin-top:22px}footer{display:flex;align-items:center;justify-content:space-between;padding:35px 5vw;background:#000;color:#fff}footer p{font-size:10px;color:#999}@media(max-width:800px){.topbar{height:70px}.topbar nav,.header-call{display:none}.menu{display:block;font-size:22px}.hero{display:block;padding:0}.hero-copy{padding:65px 7vw 55px}.hero h1{letter-spacing:-3px}.hero-actions{align-items:flex-start;flex-direction:column;gap:20px}.trust-row{margin-top:45px;gap:17px}.hero-visual{min-height:450px}.orbit{width:370px;height:370px}.orbit-two{width:270px;height:270px}.house-card{width:225px;height:285px}.status-card{right:5%;top:14%}.device-card{left:5%;bottom:12%}.statement,.section,.bla